---
/* ============================================================
   CONTAINER — horizontal rhythm of the whole site.
   Editorial max-width with fluid gutters.
   width: 'wide' (default) | 'narrow' (long-form measure)
   ============================================================ */
interface Props {
  width?: 'wide' | 'narrow';
  class?: string;
}

const { width = 'wide', class: className } = Astro.props;
---

<div class:list={['container', `container--${width}`, className]}>
  <slot />
</div>

<style>
  .container {
    margin-inline: auto;
    padding-inline: var(--gutter);
    width: 100%;
  }

  .container--wide   { max-width: var(--container); }
  .container--narrow { max-width: var(--container-narrow); }
</style>
