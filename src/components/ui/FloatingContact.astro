---
/* Compact contact launcher on small screens; direct links on desktop. */
const phone = '918270596210';

import { site } from '../../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const startsWithHero = path === site.base || path.startsWith(`${site.base}/flavours/`);

const links = [
  {
    label: 'WhatsApp',
    href: `https://wa.me/${phone}`,
    target: '_blank',
    rel: 'noopener noreferrer',
    color: '#25d366',
    icon: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>',
  },
  {
    label: 'Message',
    href: `sms:+918270596210`,
    target: '_self',
    rel: '',
    color: '#1a73e8',
    icon: '<path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/><path d="M7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>',
  },
  {
    label: 'Call',
    href: `tel:+918270596210`,
    target: '_self',
    rel: '',
    color: '#f47b00',
    icon: '<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>',
  },
];
---

<div class:list={['floating-contact', { 'is-suppressed': startsWithHero }]} data-floating-contact aria-label="Contact us">
  <button type="button" class="floating-contact__toggle clay-sm" data-contact-toggle aria-label="Contact SPARK" aria-expanded="false" aria-controls="contact-options">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 11.5a8 8 0 0 1-8 8 8.8 8.8 0 0 1-3-.5L4 20l1-4.4a8 8 0 1 1 15-4.1Z" />
      <path d="M8 11.5h8" />
    </svg>
  </button>
  <div class="floating-contact__options" id="contact-options" data-contact-options>
    {links.map((link) => (
      <a
        href={link.href}
        class="floating-contact__btn"
        aria-label={link.label}
        target={link.target}
        rel={link.rel}
        style={`--fc-color: ${link.color};`}
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          set:html={link.icon}
        />
      </a>
    ))}
  </div>
</div>

<style>
  .floating-contact {
    position: fixed;
    bottom: 2rem;
    right: 1.5rem;
    z-index: var(--z-header);
  }

  .floating-contact.is-suppressed { display: none; }

  .floating-contact__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .floating-contact__toggle { display: none; }

  .floating-contact__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--cream-50), var(--cream-200));
    box-shadow: var(--shadow-clay-sm);
    color: var(--fc-color);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .floating-contact__btn {
      transition:
        translate var(--duration-fast) var(--ease-out-expo),
        box-shadow var(--duration-fast) var(--ease-out-expo),
        background-color var(--duration-fast) ease;
    }

    .floating-contact__btn:hover {
      translate: 0 -4px;
      box-shadow: var(--shadow-clay-hover);
    }

    .floating-contact__btn:active {
      translate: 0 0;
    }
  }

  .floating-contact__btn:hover {
    background: var(--fc-color);
    color: var(--cream-50);
  }

  @media (max-width: 48rem) {
    .floating-contact {
      position: fixed;
      bottom: max(1rem, env(safe-area-inset-bottom));
      right: max(1rem, env(safe-area-inset-right));
    }
    .floating-contact__toggle {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--ink-900);
      color: var(--cream-50);
      box-shadow: 0 8px 24px rgb(26 20 16 / 0.22);
    }
    .floating-contact__options {
      position: absolute;
      right: 0;
      bottom: calc(100% + var(--space-2xs));
      padding: var(--space-2xs);
      border-radius: var(--radius-pill);
      background: var(--cream-100);
      box-shadow: var(--shadow-clay-sm);
    }
    :global(.js) .floating-contact__options:not(.is-open) { display: none; }
    .floating-contact__options .floating-contact__btn {
      box-shadow: none;
    }
    :global(html:not(.js)) .floating-contact {
      position: static;
      display: flex;
      justify-content: flex-end;
      padding: var(--space-s) var(--gutter);
    }
    :global(html:not(.js)) .floating-contact__options {
      position: static;
      flex-direction: row;
    }
  }

</style>

<script>
  const contact = document.querySelector<HTMLElement>('[data-floating-contact]');
  const toggle = contact?.querySelector<HTMLButtonElement>('[data-contact-toggle]');
  const options = contact?.querySelector<HTMLElement>('[data-contact-options]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close contact options' : 'Contact SPARK');
    options?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (event) => {
    if (contact && !contact.contains(event.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  if (contact && 'IntersectionObserver' in window) {
    const blocking = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) blocking.add(entry.target);
        else blocking.delete(entry.target);
      }
      contact.classList.toggle('is-suppressed', blocking.size > 0);
      if (blocking.size > 0) setOpen(false);
    });
    document.querySelectorAll('.hero, .flavour-hero').forEach((element) => observer.observe(element));
  }
</script>
