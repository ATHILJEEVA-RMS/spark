---
/* ============================================================
   FLAVOUR CARD — a mini advertising poster.
   Each card owns its flavour's atmosphere: cream → soft →
   primary gradient, the staged can (glow, splash, reflection),
   oversized name, emotional tagline and an Explore cue.
   ============================================================ */
import type { CollectionEntry } from 'astro:content';
import CanStage from '../CanStage.astro';

interface Props {
  flavour: CollectionEntry<'flavours'>;
  index?: number;
}

const { flavour, index = 0 } = Astro.props;
const { name, tagline, mood, colors, status } = flavour.data;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={`/flavours/${flavour.id}`}
  class="flavour-card"
  style={`--reveal-delay: ${(index % 4) * 90}ms; --flavour-primary: ${colors.primary}; --flavour-deep: ${colors.deep}; --flavour-soft: ${colors.soft};`}
  data-reveal="up"
>
  <span class="flavour-card__top">
    <span class="flavour-card__num" aria-hidden="true">{num}</span>
    {status !== 'current' && <span class="flavour-card__badge">{status}</span>}
  </span>

  <CanStage {flavour} variant="card" class="flavour-card__stage" />

  <span class="flavour-card__meta">
    <span class="flavour-card__mood">{mood}</span>
    <span class="flavour-card__name">{name}</span>
    <span class="flavour-card__tagline">{tagline}</span>
  </span>

  <span class="flavour-card__explore">
    Explore
    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .flavour-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    padding: var(--space-m) var(--space-s) var(--space-m);
    border-radius: var(--radius-clay);
    /* the card's own little world */
    background:
      radial-gradient(
        90% 55% at 50% 30%,
        color-mix(in oklab, var(--flavour-primary) 26%, transparent) 0%,
        transparent 70%
      ),
      linear-gradient(
        168deg,
        var(--cream-50) 0%,
        var(--flavour-soft) 52%,
        color-mix(in oklab, var(--flavour-soft) 55%, var(--flavour-primary)) 130%
      );
    box-shadow: var(--shadow-clay-sm);
    overflow: hidden;
    text-align: center;
    transition:
      box-shadow var(--duration-med) var(--ease-out-expo),
      translate var(--duration-med) var(--ease-out-expo);
  }

  .flavour-card:hover {
    box-shadow: var(--shadow-clay-hover);
    translate: 0 -8px;
  }

  .flavour-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .flavour-card__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--flavour-primary) 75%, var(--ink-500));
  }

  .flavour-card__badge {
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--flavour-primary);
    color: var(--cream-50);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .flavour-card__stage {
    transition: scale var(--duration-med) var(--ease-spring);
  }

  .flavour-card:hover .flavour-card__stage {
    scale: 1.04;
  }

  .flavour-card__meta {
    display: grid;
    gap: var(--space-3xs);
  }

  .flavour-card__mood {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--flavour-primary) 85%, var(--ink-700));
  }

  .flavour-card__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
  }

  .flavour-card__tagline {
    font-size: var(--text-sm);
    font-style: italic;
    font-family: var(--font-display);
    color: var(--ink-500);
  }

  .flavour-card__explore {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: var(--space-2xs);
    padding: 0.55em 1.3em;
    border-radius: var(--radius-pill);
    background: linear-gradient(145deg, rgb(253 251 245 / 0.9), color-mix(in oklab, var(--flavour-soft) 80%, white));
    box-shadow: var(--shadow-clay-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-900);
    transition:
      gap var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) ease;
  }

  .flavour-card:hover .flavour-card__explore {
    gap: var(--space-2xs);
    color: var(--flavour-deep);
  }
</style>
