---
interface Props {
  title: string;
  body: string;
  icon?: 'fruit' | 'bubbles' | 'bottle' | 'can' | 'share' | 'globe' | 'basket' | 'pen' | 'spark' | 'mail';
  index?: number;
}

const { title, body, icon = 'fruit', index = 0 } = Astro.props;
const accents = [
  ['var(--orange-deep)', 'var(--orange-soft)'],
  ['var(--litchi-deep)', 'var(--litchi-soft)'],
  ['var(--blueberry-deep)', 'var(--blueberry-soft)'],
];
const [accent, soft] = accents[index % accents.length];

const icons = {
  fruit: '<circle cx="12" cy="13" r="7"/><path d="M12 6c0-2.5 2-4.5 4.5-4.5.3 2.6-1.8 4.5-4.5 4.5z"/>',
  bubbles: '<circle cx="8" cy="10" r="3.5"/><circle cx="15.5" cy="7.5" r="2"/><circle cx="14" cy="15" r="3"/>',
  bottle: '<path d="M9 2h6v3l1.5 2v2.5c1.8 1.2 2.5 2.7 2.5 4.5V20a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6c0-1.8.7-3.3 2.5-4.5V7L9 5V2Z"/><path d="M9 5h6M6 13h12M6 18h12"/>',
  can: '<rect x="8" y="3" width="8" height="18" rx="2.5"/><path d="M8 8h8M8 17h8"/>',
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4.2 5.7 4.2 9S14.8 18.4 12 21c-2.8-2.6-4.2-5.7-4.2-9S9.2 5.6 12 3z"/>',
  basket: '<path d="M4 9h16l-1.5 11h-13L4 9zM8 9l4-6 4 6"/>',
  pen: '<path d="M4 20l1-4L16 5l3 3L8 19l-4 1zM14 7l3 3"/>',
  spark: '<path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
};
---

<article
  class="feature-card"
  data-reveal="up"
  style={`--feature-accent: ${accent}; --feature-soft: ${soft}; --reveal-delay: ${index * 100}ms`}
>
  <div class="feature-card__topline">
    <span class="feature-card__index">0{index + 1} <i></i> 03</span>
    <span class="feature-card__icon" aria-hidden="true">
      <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
    </span>
  </div>
  <div class="feature-card__copy">
    <h3 class="feature-card__title">{title}</h3>
    <p class="feature-card__body">{body}</p>
  </div>
</article>

<style>
  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-l);
    min-height: 16rem;
    padding: var(--space-l);
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--feature-accent) 12%, white);
    border-radius: var(--radius-clay);
    background:
      radial-gradient(90% 90% at 100% 0%, color-mix(in oklab, var(--feature-soft) 92%, white), transparent 76%),
      linear-gradient(145deg, var(--cream-50), color-mix(in oklab, var(--feature-soft) 54%, white));
    box-shadow: var(--shadow-clay-sm);
    transition: translate 260ms var(--ease-out-expo), box-shadow 260ms var(--ease-out-expo);
  }

  .feature-card::after {
    position: absolute;
    top: -2.5rem;
    right: -2.25rem;
    width: 8rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklab, var(--feature-accent) 18%, transparent);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  @media (hover: hover) {
    .feature-card:hover { translate: 0 -4px; box-shadow: var(--shadow-clay-hover); }
    .feature-card:hover .feature-card__icon { rotate: 7deg; scale: 1.05; }
  }

  .feature-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .feature-card__index {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--feature-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .feature-card__index i {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: color-mix(in oklab, var(--feature-accent) 55%, white);
  }

  .feature-card__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.25rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklab, var(--feature-accent) 15%, white);
    border-radius: 50%;
    background: color-mix(in oklab, var(--cream-50) 78%, transparent);
    box-shadow: var(--shadow-clay-sm);
    color: var(--feature-accent);
    transition: rotate 260ms var(--ease-out-expo), scale 260ms var(--ease-out-expo);
  }

  .feature-card__copy { display: grid; align-content: start; gap: var(--space-2xs); }

  .feature-card__title {
    font-size: var(--text-lg);
    line-height: 1.1;
  }

  .feature-card__body {
    max-width: 33ch;
    color: var(--ink-500);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  @media (max-width: 64rem) {
    .feature-card { min-height: 15rem; padding: var(--space-m); }
  }

  @media (max-width: 52rem) {
    .feature-card { min-height: 0; gap: var(--space-m); }
  }

  @media (max-width: 30rem) {
    .feature-card { border-radius: var(--radius-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .feature-card__icon { transition: none; }
  }
</style>
