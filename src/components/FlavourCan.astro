---
/* ============================================================
   FLAVOUR CAN — the single place every can image on the site
   is rendered.

   Assets are studio renders with transparent backgrounds.
   Original photo cutouts remain in assets/flavours for reference.
   served through Astro's image pipeline: responsive srcsets in
   modern formats, intrinsic dimensions baked in (zero CLS).

   The component only *stages* the artwork — it never alters
   the can render itself (branding stays pixel-perfect).
   ============================================================ */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  flavour: CollectionEntry<'flavours'>;
  loading?: 'lazy' | 'eager';
  /* Rendered width budget; the pipeline also generates a 2× source. */
  width?: number;
  sizes?: string;
  class?: string;
}

const {
  flavour,
  loading = 'lazy',
  width = 420,
  sizes = '(max-width: 48rem) 60vw, 22rem',
  class: className,
} = Astro.props;
const { src, alt } = flavour.data.image;
---

<Image
  {src}
  {alt}
  {loading}
  {width}
  {sizes}
  widths={[width, width * 2]}
  format="webp"
  quality={86}
  decoding="async"
  class:list={['flavour-can', className]}
/>

<style>
  .flavour-can {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 0.44;
    object-fit: cover;
    object-position: center;
  }
</style>
