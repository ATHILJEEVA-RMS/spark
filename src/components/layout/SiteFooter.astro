---
/* ============================================================
   SITE FOOTER — editorial sign-off.
   Ink block on the cream page with soft clay top corners:
   brand column with socials, flavour links generated from the
   collection, data-driven link columns and a contact invitation.
   ============================================================ */
import { getCollection } from 'astro:content';
import { footer, site } from '../../data/site';
import Container from '../ui/Container.astro';

const flavours = (await getCollection('flavours')).sort((a, b) => a.data.order - b.data.order);

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/hogwards_foods_and_beverages?stkn=ODQ2NWM2aHR1MTBr', icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>' },
];
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">
          {footer.wordmark.pre} <em>{footer.wordmark.accent}</em>
        </p>
        <p class="site-footer__tagline">{footer.tagline}</p>

        <ul class="site-footer__socials" role="list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} class="site-footer__social" aria-label={`${site.brand} on ${s.label}`}>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="site-footer__col" aria-label="Flavours">
        <h4 class="site-footer__heading">Flavours</h4>
        <ul role="list">
          {
            flavours.map((f) => (
              <li>
                <a href={`/spark/flavours/${f.id}`} class="site-footer__link">{f.data.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        footer.columns.map((col) => (
          <nav class="site-footer__col" aria-label={col.title}>
            <h4 class="site-footer__heading">{col.title}</h4>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="site-footer__link">{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="site-footer__col site-footer__contact">
        <h4 class="site-footer__heading">{footer.contact.title}</h4>
        <p class="site-footer__contact-copy">{footer.contact.copy}</p>
        <a class="site-footer__contact-link" href={footer.contact.href}>{footer.contact.cta} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="site-footer__base">
      <p>{footer.legal}</p>
      <p class="site-footer__fine">Crafted in Tamil Nadu</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background: var(--ink-900);
    color: var(--cream-100);
    padding-block: var(--space-2xl) var(--space-m);
    border-radius: var(--radius-clay) var(--radius-clay) 0 0;
    margin-top: var(--section-gap);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 0.9fr 0.9fr 1.3fr;
    gap: var(--space-l);
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
  }

  .site-footer__wordmark em {
    color: var(--orange);
    font-style: italic;
    font-weight: 400;
  }

  .site-footer__tagline {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-300);
    font-size: var(--text-sm);
    max-width: 30ch;
  }

  .site-footer__socials {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .site-footer__social {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(250 245 234 / 0.08);
    color: var(--cream-200);
    transition:
      background-color var(--duration-fast) ease,
      translate var(--duration-fast) var(--ease-out-expo);
  }

  .site-footer__social:hover {
    background: var(--orange);
    color: var(--cream-50);
    translate: 0 -3px;
  }

  .site-footer__heading {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-300);
    margin-bottom: var(--space-s);
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    color: var(--cream-200);
    font-size: var(--text-sm);
    opacity: 0.85;
    transition: opacity var(--duration-fast) ease, padding-left var(--duration-fast) var(--ease-out-expo);
  }

  .site-footer__link:hover {
    opacity: 1;
    padding-left: 0.35em;
  }

  /* ---------- Contact ---------- */
  .site-footer__contact-copy {
    font-size: var(--text-sm);
    color: var(--ink-300);
    margin-bottom: var(--space-s);
  }

  .site-footer__contact-link {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    min-height: 2.75rem;
    color: var(--cream-50);
    font-weight: 600;
    border-bottom: 1px solid var(--orange);
  }

  /* ---------- Base ---------- */
  .site-footer__base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid rgb(250 245 234 / 0.14);
    font-size: var(--text-xs);
    color: var(--ink-300);
  }

  @media (max-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand,
    .site-footer__contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .site-footer {
      padding-block: var(--space-xl) var(--space-s);
    }
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .site-footer__wordmark {
      font-size: var(--text-xl);
    }
    .site-footer__base {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }
  }
</style>
