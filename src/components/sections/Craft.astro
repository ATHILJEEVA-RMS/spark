---
import { craft } from '../../data/site';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import FeatureCard from '../cards/FeatureCard.astro';

type IconName = 'fruit' | 'bubbles' | 'can' | 'share' | 'globe' | 'basket' | 'pen' | 'spark' | 'mail';
const [h1, h2] = craft.heading;
---

<Section id="craft" class="craft-section" spacing="default">
  <div class="craft__head">
    <div class="craft__headline">
      <Eyebrow>{craft.eyebrow}</Eyebrow>
      <h2 class="craft__title" data-reveal="up">
        <span>{h1}</span>
        <span class="craft__title-accent"><em>{h2}</em></span>
      </h2>
    </div>

    <div class="craft__intro" data-reveal="up" style="--reveal-delay: 100ms">
      <span class="craft__origin">
        <span class="craft__origin-mark" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M10 18s6-5.15 6-10a6 6 0 1 0-12 0c0 4.85 6 10 6 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        Crafted in Tamil Nadu
      </span>
      <p>Eight sparkling flavours. Find the one you’ll reach for next.</p>
      <Button href={craft.cta.href} variant="ghost" size="md">{craft.cta.label}</Button>
    </div>
  </div>

  <div class="craft__grid">
    {
      craft.items.map((item, i) => (
        <FeatureCard title={item.title} body={item.body} icon={item.icon as IconName} index={i} />
      ))
    }
  </div>
</Section>

<style>
  .craft__head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
    margin-bottom: var(--space-xl);
  }

  .craft__headline { display: grid; justify-items: start; gap: var(--space-s); }

  .craft__title {
    font-size: clamp(3rem, 5.2vw, 5rem);
    line-height: 0.95;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .craft__title span { display: block; }

  .craft__title-accent em {
    color: var(--orange-deep);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
  }

  .craft__intro {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    padding-bottom: 0.25rem;
  }

  .craft__origin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.4rem 0.8rem 0.4rem 0.4rem;
    border: 1px solid color-mix(in oklab, var(--orange) 24%, white);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--orange-soft) 65%, white);
    color: var(--ink-700);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .craft__origin-mark {
    display: grid;
    place-items: center;
    width: 1.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    color: white;
    font-size: 1.1rem;
    line-height: 1;
  }

  .craft__intro p {
    max-width: 30ch;
    color: var(--ink-500);
    font-size: var(--text-md);
    line-height: 1.45;
  }

  .craft__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--space-s);
  }

  @media (max-width: 64rem) {
    .craft__head { grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr); gap: var(--space-l); }
    .craft__title { font-size: clamp(2.8rem, 5.4vw, 4rem); }
    .craft__grid { gap: var(--space-xs); }
  }

  @media (max-width: 52rem) {
    .craft__head { grid-template-columns: 1fr; align-items: start; gap: var(--space-m); }
    .craft__title { font-size: clamp(2.8rem, 8.8vw, 4.2rem); }
    .craft__intro { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .craft__intro p { grid-column: 1; }
    .craft__intro :global(.btn) { grid-column: 2; grid-row: 1 / span 2; }
    .craft__grid { grid-template-columns: 1fr; gap: var(--space-s); }
  }

  @media (max-width: 30rem) {
    .craft__head { margin-bottom: var(--space-l); }
    .craft__title { font-size: clamp(2.55rem, 11vw, 3.4rem); }
    .craft__intro { grid-template-columns: 1fr; }
    .craft__intro p,
    .craft__intro :global(.btn) { grid-column: auto; grid-row: auto; }
  }
</style>
