---
/* ============================================================
   MANIFESTO — the brand's opening argument.
   Editorial type over a flavour-matched, carbonated juice pool.
   Copy comes from site.ts.
   ============================================================ */
import { manifesto } from '../../data/site';
import Eyebrow from '../ui/Eyebrow.astro';

const [l1, l2] = manifesto.heading;
const random = (seed: number) => {
  const value = Math.sin(seed * 78.233) * 43758.5453;
  return value - Math.floor(value);
};
const bubbleStreams = [8, 17, 29, 43, 57, 71, 83, 92];
const liquidBubbles = Array.from({ length: 112 }, (_, index) => {
  const size = 2 + Math.pow(random(index + 91), 1.7) * 8;
  const duration = 12.5 - size * .55 + random(index + 51) * 2.5;
  return {
    x: Math.max(2, Math.min(98, bubbleStreams[index % bubbleStreams.length] + (random(index + 4) - .5) * 13)).toFixed(1),
    size: size.toFixed(1),
    duration: duration.toFixed(2),
    delay: (-(random(index + 127) * duration)).toFixed(2),
    drift: Math.round((random(index + 173) - .5) * 28),
    stillY: (4 + random(index + 219) * 90).toFixed(1),
  };
});
---

<section class="manifesto" id="story">
  {/* A natural continuation of the hero's soft flavour fade */}
  <div class="manifesto__juice-stage" aria-hidden="true">
    <svg class="manifesto__juice-wave" viewBox="0 0 4320 800" preserveAspectRatio="none">
      <defs>
        <linearGradient id="manifesto-juice-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 52%, var(--active-flavour-soft))" />
          <stop offset="40%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 68%, var(--active-flavour-soft))" />
          <stop offset="100%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 86%, var(--active-flavour-soft))" />
        </linearGradient>
      </defs>
      <path class="manifesto__juice-fill" d="M0 310 C720 296 1440 324 2160 310 S3600 296 4320 310 L4320 800 L0 800Z" />
      <path class="manifesto__surface-glint" d="M0 310 C720 296 1440 324 2160 310 S3600 296 4320 310" />
      <path class="manifesto__surface-ripple" d="M0 354 C710 344 1420 363 2160 352 S3600 344 4320 354" />
      <path class="manifesto__surface-ripple manifesto__surface-ripple--low" d="M0 390 C720 382 1440 397 2160 389 S3600 383 4320 390" />
    </svg>
    <div class="manifesto__liquid-light"></div>
    <div class="manifesto__liquid-bubbles">
      {liquidBubbles.map((bubble) => (
        <span
          class="manifesto__liquid-bubble"
          style={`--x:${bubble.x}%;--size:${bubble.size}px;--duration:${bubble.duration}s;--delay:${bubble.delay}s;--drift:${bubble.drift}px;--still-y:${bubble.stillY}%`}
        />
      ))}
    </div>
  </div>
  <div class="manifesto__content">
    <div class="manifesto__inner" data-reveal="up">
      <Eyebrow class="manifesto__eyebrow">{manifesto.eyebrow}</Eyebrow>

      <h2 class="manifesto__title">
        <span class="manifesto__line">
          {l1}
        </span>
        <span class="manifesto__line manifesto__line--accent">
          <em>{l2}</em>
        </span>
      </h2>

      <p class="manifesto__body" data-reveal="up" style="--reveal-delay: 160ms">
        {manifesto.body}
      </p>

    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#story');
  const orientationApi = window.DeviceOrientationEvent;
  const mobileViewport = window.matchMedia('(max-width: 48rem)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reducedMotion) {
    const liquidSurface = section.querySelector<SVGPathElement>('.manifesto__juice-fill');
    const surfaceGlint = section.querySelector<SVGPathElement>('.manifesto__surface-glint');
    const baseSurface = 310;
    const surfaceSegments = 72;
    const surfaceHeights = Array.from({ length: surfaceSegments + 1 }, (_, index) =>
      baseSurface - Math.sin((index / surfaceSegments) * Math.PI * 4) * 14,
    );
    const surfaceVelocities = Array.from({ length: surfaceSegments + 1 }, () => 0);
    let baselineGamma: number | undefined;
    let baselineBeta: number | undefined;
    let lastSensorEvent = 0;
    let lastFrameTime = 0;
    let frame = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const drawSurface = (time: number) => {
      const step = Math.min(2, lastFrameTime ? (time - lastFrameTime) / 16.667 : 1);
      lastFrameTime = time;
      const center = baseSurface - currentY * 34;
      const slope = currentX * 105;
      let moving = false;
      const previousHeights = [...surfaceHeights];

      for (let index = 0; index <= surfaceSegments; index += 1) {
        const fraction = index / surfaceSegments;
        const desired = center - (fraction - 0.5) * slope;
        const height = surfaceHeights[index];
        const left = previousHeights[Math.max(0, index - 1)];
        const right = previousHeights[Math.min(surfaceSegments, index + 1)];
        const spring = (desired - height) * 0.045;
        const neighborPull = ((left + right) * 0.5 - height) * 0.13;
        surfaceVelocities[index] = (surfaceVelocities[index] + (spring + neighborPull) * step) * Math.pow(0.935, step);
        surfaceHeights[index] += surfaceVelocities[index] * step;

        if (Math.abs(surfaceVelocities[index]) > 0.08 || Math.abs(desired - surfaceHeights[index]) > 0.7) moving = true;
      }

      const segmentWidth = 4320 / surfaceSegments;
      let line = `M 0 ${surfaceHeights[0].toFixed(2)}`;
      for (let index = 0; index < surfaceSegments; index += 1) {
        const startX = index * segmentWidth;
        const endX = (index + 1) * segmentWidth;
        const before = surfaceHeights[Math.max(0, index - 1)];
        const start = surfaceHeights[index];
        const end = surfaceHeights[index + 1];
        const after = surfaceHeights[Math.min(surfaceSegments, index + 2)];
        const firstControl = start + (end - before) / 6;
        const secondControl = end - (after - start) / 6;
        line += ` C ${(startX + segmentWidth / 3).toFixed(2)} ${firstControl.toFixed(2)} ${(endX - segmentWidth / 3).toFixed(2)} ${secondControl.toFixed(2)} ${endX.toFixed(2)} ${end.toFixed(2)}`;
      }

      liquidSurface?.setAttribute('d', `${line} L 4320 800 L 0 800 Z`);
      surfaceGlint?.setAttribute('d', line);
      return moving;
    };

    const easeTilt = () => {
      currentX += (targetX - currentX) * 0.12;
      currentY += (targetY - currentY) * 0.12;
      section.style.setProperty('--tilt-x', currentX.toFixed(3));
      section.style.setProperty('--tilt-y', currentY.toFixed(3));
      const surfaceMoving = drawSurface(performance.now());

      if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002 || surfaceMoving) {
        frame = requestAnimationFrame(easeTilt);
      } else {
        frame = 0;
        lastFrameTime = 0;
      }
    };

    const animateLiquid = () => {
      if (!frame) frame = requestAnimationFrame(easeTilt);
    };

    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.gamma === null || event.beta === null) return;
      lastSensorEvent = performance.now();
      baselineGamma ??= event.gamma;
      baselineBeta ??= event.beta;
      targetX = clamp((event.gamma - baselineGamma) / 22);
      targetY = clamp((event.beta - baselineBeta) / 25);
      animateLiquid();
    };

    const onPointerMove = (event: PointerEvent) => {
      // Use direct touch/pen/mouse movement when motion sensors are blocked
      // or unavailable. Sensor data takes priority whenever it is flowing.
      if (performance.now() - lastSensorEvent < 1000 || !section) return;
      const bounds = section.getBoundingClientRect();
      targetX = clamp(((event.clientX - bounds.left) / bounds.width - 0.5) * 1.6);
      targetY = clamp(((event.clientY - bounds.top) / bounds.height - 0.5) * 1.2);
      animateLiquid();
    };

    const settleLiquid = () => {
      if (performance.now() - lastSensorEvent < 1000) return;
      targetX = 0;
      targetY = 0;
      animateLiquid();
    };

    if (mobileViewport && window.isSecureContext && orientationApi) {
      // Browsers that have already granted motion access deliver events
      // automatically. No permission prompt or on-page enable button.
      window.addEventListener('deviceorientation', onOrientation, { passive: true });
    }

    section.addEventListener('pointermove', onPointerMove, { passive: true });
    section.addEventListener('pointerup', settleLiquid, { passive: true });
    section.addEventListener('pointerleave', settleLiquid, { passive: true });
    section.addEventListener('pointercancel', settleLiquid, { passive: true });
  }
</script>

<style>
  .manifesto {
    position: relative;
    overflow: visible;
    isolation: isolate;
    perspective: 1100px;
    transform-style: preserve-3d;
    --tilt-x: 0;
    --tilt-y: 0;
    min-height: clamp(32rem, 43vw, 37rem);
    padding-block: calc(var(--section-gap) * .55) calc(var(--section-gap) * 1.1);
    background: transparent;
  }

  /* ---------- A responsive pool of flavour-matched juice ---------- */
  .manifesto__juice-stage {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .manifesto__juice-stage::before,
  .manifesto__juice-stage::after {
    content: '';
    position: absolute;
    z-index: 2;
    left: -8%;
    width: 116%;
    pointer-events: none;
  }

  /* Broad ellipse and front lip make the full-width liquid read as a pool. */
  .manifesto__juice-stage::before {
    top: 39%;
    bottom: -8%;
    border: 2px solid rgb(255 255 255 / .72);
    border-bottom: 0;
    border-radius: 50% 50% 0 0 / 11% 11% 0 0;
    background: linear-gradient(180deg, rgb(255 255 255 / .14), transparent 23%);
    box-shadow: inset 0 22px 28px rgb(255 255 255 / .2), 0 -5px 16px rgb(255 255 255 / .34), 0 8px 22px rgb(67 42 18 / .12);
  }

  .manifesto__juice-stage::after {
    bottom: 0;
    height: 14px;
    background: linear-gradient(180deg, rgb(255 255 255 / .2), rgb(46 31 16 / .1));
    box-shadow: 0 -8px 28px rgb(69 43 13 / .08);
  }

  .manifesto__juice-wave {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    width: 300vw;
    max-width: none;
    height: 100%;
    overflow: visible;
    will-change: transform;
    translate: calc(var(--tilt-x) * 4px) calc(var(--tilt-y) * -3px) -16px;
  }

  .manifesto__juice-fill {
    fill: url(#manifesto-juice-gradient);
  }

  .manifesto__surface-glint {
    fill: none;
    stroke: rgb(255 255 255 / .72);
    stroke-width: 9;
    stroke-linecap: round;
    filter: drop-shadow(0 2px 5px rgb(255 255 255 / .35));
    pointer-events: none;
  }

  .manifesto__surface-ripple {
    fill: none;
    stroke: rgb(255 255 255 / .23);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 120 45 280 80;
    opacity: .8;
    animation: pool-reflection 9s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .manifesto__surface-ripple--low {
    stroke: rgb(67 42 18 / .12);
    stroke-width: 2;
    stroke-dasharray: 260 95 140 170;
    animation-duration: 13s;
    animation-direction: alternate-reverse;
  }

  @keyframes pool-reflection {
    from { stroke-dashoffset: 0; opacity: .42; }
    to { stroke-dashoffset: -560; opacity: .9; }
  }

  .manifesto__liquid-light {
    position: absolute;
    z-index: 1;
    inset: 31% 0 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 42% at 48% 0%, rgb(255 255 255 / .3), transparent 88%),
      radial-gradient(ellipse 30% 68% at 8% 22%, rgb(255 255 255 / .2), transparent 82%),
      radial-gradient(ellipse 34% 75% at 92% 28%, rgb(255 255 255 / .16), transparent 84%),
      linear-gradient(180deg, rgb(255 255 255 / .18), transparent 36%, rgb(48 30 12 / .12));
    mix-blend-mode: screen;
    transform: translate3d(calc(var(--tilt-x) * 12px), calc(var(--tilt-y) * 8px), 0);
  }

  .manifesto__liquid-bubbles {
    position: absolute;
    z-index: 2;
    inset: 31% 0 0;
    overflow: hidden;
    pointer-events: none;
    transform: translate3d(calc(var(--tilt-x) * 16px), calc(var(--tilt-y) * 10px), 0);
    transition: transform 120ms linear;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%);
    mask-image: linear-gradient(to bottom, transparent, #000 10%);
  }

  .manifesto__liquid-bubble {
    position: absolute;
    left: var(--x);
    bottom: -.75rem;
    width: var(--size);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / .64);
    border-radius: 50%;
    background: radial-gradient(circle at 29% 26%, rgb(255 255 255 / .88) 0 10%, rgb(255 255 255 / .1) 30%, transparent 75%);
    box-shadow: inset -1px -1px 2px rgb(33 27 20 / .13), 0 0 5px rgb(255 255 255 / .19);
    opacity: 0;
    will-change: transform, opacity;
    animation: liquid-rise var(--duration) linear var(--delay) infinite;
  }

  @keyframes liquid-rise {
    0% { transform: translate3d(0, 0, 0) scale(.7); opacity: 0; }
    10% { opacity: .72; }
    45% { transform: translate3d(calc(var(--drift) * -.35), -18rem, 0) scale(1); opacity: .7; }
    75% { transform: translate3d(calc(var(--drift) * .3), -31rem, 0) scale(.9); opacity: .54; }
    100% { transform: translate3d(var(--drift), -44rem, 0) scale(.72); opacity: 0; }
  }

  /* ---------- Content ---------- */
  .manifesto__content {
    position: relative;
    z-index: 3;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    transform-style: preserve-3d;
  }

  .manifesto__inner {
    display: grid;
    justify-items: center;
    gap: clamp(.65rem, 1.5vw, 1.15rem);
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
    padding-block: clamp(1.8rem, 4vw, 3.4rem) 0;
    text-align: center;
  }

  .manifesto__eyebrow {
    justify-content: center;
  }

  .manifesto__title {
    font-size: clamp(3.8rem, 7.4vw, 6.75rem);
    line-height: var(--leading-none);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    transform: translate3d(calc(var(--tilt-x) * -4px), calc(var(--tilt-y) * -3px), 30px);
  }

  .manifesto__line {
    display: block;
  }

  .manifesto__line--accent em {
    font-size: 1.32em;
    font-weight: 400;
    text-transform: none;
    color: white;
    text-shadow: 0 .12em .42em rgb(0 0 0 / .14);
  }

  .manifesto__line em {
    font-style: italic;
  }

  .manifesto__body {
    font-size: var(--text-md);
    color: var(--ink-900);
    max-width: 42ch;
    text-shadow: 0 1px rgb(255 255 255 / .22);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto__surface-ripple,
    .manifesto__liquid-bubble { animation: none; }
    .manifesto__liquid-bubble { top: var(--still-y); bottom: auto; opacity: .48; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 48rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 29rem;
      touch-action: pan-y;
    }
    .manifesto__juice-wave { top: calc(-12% + var(--tilt-y) * -4px); height: calc(118% + 8px); }
    .manifesto__juice-stage::before { top: 33%; left: -12%; width: 124%; border-radius: 50% 50% 0 0 / 14% 14% 0 0; }
    .manifesto__juice-stage::after { height: 9px; }
    .manifesto__surface-ripple { stroke-width: 2; }
    .manifesto__liquid-bubble:nth-child(3n) { display: none; }
    .manifesto__liquid-light,
    .manifesto__liquid-bubbles { top: 20%; }
  }

  @media (max-width: 30rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 27rem;
    }
    .manifesto__inner {
      gap: var(--space-s);
    }
    .manifesto__title {
      font-size: var(--text-2xl);
    }
    .manifesto__body {
      font-size: var(--text-base);
    }
    .manifesto { padding-bottom: 8rem; }
    .manifesto__inner { width: calc(100% - 1rem); padding-top: 1.25rem; }
  }
</style>
