---
/* ============================================================
   MANIFESTO — the brand's opening argument.
   Editorial type over a flavour-matched, carbonated juice pool.
   Copy comes from site.ts.
   ============================================================ */
import { manifesto } from '../../data/site';
import Eyebrow from '../ui/Eyebrow.astro';

const [l1, l2] = manifesto.heading;
const random = (seed: number) => {
  const value = Math.sin(seed * 78.233) * 43758.5453;
  return value - Math.floor(value);
};
const bubbleStreams = [8, 17, 29, 43, 57, 71, 83, 92];
const liquidBubbles = Array.from({ length: 120 }, (_, index) => {
  const size = 1.4 + Math.pow(random(index + 91), 1.8) * 7;
  const duration = 9.5 - size * .4 + random(index + 51) * 3;
  return {
    x: Math.max(2, Math.min(98, bubbleStreams[index % bubbleStreams.length] + (random(index + 4) - .5) * 13)).toFixed(1),
    size: size.toFixed(1),
    duration: duration.toFixed(2),
    delay: (-(random(index + 127) * duration)).toFixed(2),
    drift: Math.round((random(index + 173) - .5) * 28),
    stillY: (4 + random(index + 219) * 90).toFixed(1),
  };
});
const initialSurfaceHeights = Array.from({ length: 73 }, (_, index) =>
  310 - Math.sin((index / 72) * Math.PI * 6) * 18,
);
let initialSurfaceLine = `M 0 ${initialSurfaceHeights[0].toFixed(2)}`;
for (let index = 0; index < 72; index += 1) {
  const x = index * 60;
  const before = initialSurfaceHeights[Math.max(0, index - 1)];
  const start = initialSurfaceHeights[index];
  const end = initialSurfaceHeights[index + 1];
  const after = initialSurfaceHeights[Math.min(72, index + 2)];
  initialSurfaceLine += ` C ${x + 20} ${(start + (end - before) / 6).toFixed(2)} ${x + 40} ${(end - (after - start) / 6).toFixed(2)} ${x + 60} ${end.toFixed(2)}`;
}
---

<section class="manifesto" id="story">
  {/* A natural continuation of the hero's soft flavour fade */}
  <div class="manifesto__juice-stage" aria-hidden="true">
    <svg class="manifesto__juice-wave" viewBox="0 0 4320 800" preserveAspectRatio="none">
      <defs>
        <linearGradient id="manifesto-juice-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 58%, var(--active-flavour-soft))" />
          <stop offset="16%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 82%, var(--active-flavour-soft))" />
          <stop offset="55%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 88%, var(--active-flavour-deep))" />
          <stop offset="100%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 65%, var(--active-flavour-deep))" />
        </linearGradient>
      </defs>
      <path class="manifesto__juice-fill" d={`${initialSurfaceLine} L 4320 800 L 0 800 Z`} />
    </svg>
    <canvas class="manifesto__liquid-caustics" aria-hidden="true"></canvas>
    <div class="manifesto__liquid-light"></div>
    <div class="manifesto__liquid-bubbles">
      {liquidBubbles.map((bubble) => (
        <span
          class="manifesto__liquid-bubble"
          style={`--x:${bubble.x}%;--size:${bubble.size}px;--duration:${bubble.duration}s;--delay:${bubble.delay}s;--drift:${bubble.drift}px;--still-y:${bubble.stillY}%`}
        />
      ))}
    </div>
  </div>
  <div class="manifesto__content">
    <div class="manifesto__inner" data-reveal="up">
      <Eyebrow class="manifesto__eyebrow">{manifesto.eyebrow}</Eyebrow>

      <h2 class="manifesto__title">
        <span class="manifesto__line">
          {l1}
        </span>
        <span class="manifesto__line manifesto__line--accent">
          <em>{l2}</em>
        </span>
      </h2>

      <p class="manifesto__body" data-reveal="up" style="--reveal-delay: 160ms">
        {manifesto.body}
      </p>

    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#story');
  const orientationApi = window.DeviceOrientationEvent;
  const mobileViewport = window.matchMedia('(max-width: 48rem)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const causticCanvas = section?.querySelector<HTMLCanvasElement>('.manifesto__liquid-caustics');

  if (section && !reducedMotion) {
    const liquidSurface = section.querySelector<SVGPathElement>('.manifesto__juice-fill');
    const baseSurface = 310;
    const surfaceSegments = 72;
    const surfaceHeights = Array.from({ length: surfaceSegments + 1 }, (_, index) =>
      baseSurface - Math.sin((index / surfaceSegments) * Math.PI * 6) * 18,
    );
    const surfaceVelocities = Array.from({ length: surfaceSegments + 1 }, () => 0);
    let baselineGamma: number | undefined;
    let baselineBeta: number | undefined;
    let lastSensorEvent = 0;
    let lastFrameTime = 0;
    let frame = 0;
    let sectionVisible = false;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const gl = causticCanvas?.getContext('webgl', { alpha: true, antialias: false, powerPreference: 'low-power', preserveDrawingBuffer: true });
    let causticProgram: WebGLProgram | null = null;
    let causticTime: WebGLUniformLocation | null = null;
    let causticTilt: WebGLUniformLocation | null = null;
    let causticResolution: WebGLUniformLocation | null = null;
    let lastCausticTime = 0;

    if (gl && causticCanvas) {
      const compileShader = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
          gl.deleteShader(shader);
          return null;
        }
        return shader;
      };

      const vertexShader = compileShader(gl.VERTEX_SHADER, `
        attribute vec2 aPosition;
        varying vec2 vUv;
        void main() {
          vUv = aPosition * .5 + .5;
          gl_Position = vec4(aPosition, 0., 1.);
        }
      `);
      const fragmentShader = compileShader(gl.FRAGMENT_SHADER, `
        precision highp float;
        varying vec2 vUv;
        uniform float uTime;
        uniform vec2 uTilt;
        uniform vec2 uResolution;

        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3. - 2. * f);
          return mix(mix(hash(i), hash(i + vec2(1., 0.)), f.x),
                     mix(hash(i + vec2(0., 1.)), hash(i + vec2(1., 1.)), f.x), f.y);
        }
        void main() {
          vec2 uv = vec2(vUv.x, 1. - vUv.y);
          float surface = .3875 - .0225 * sin(uv.x * 6.283185)
            - uTilt.y * .042 - uTilt.x * (uv.x - .5) * .043;
          float liquid = smoothstep(surface + .012, surface + .065, uv.y);
          vec2 p = uv * uResolution / 60.;
          float folded = noise(p * 1.8 + vec2(-uTime * .022, uTime * .014));
          float detail = noise(p * 3.2 + vec2(uTime * .018, uTime * .011));
          float sparkle = smoothstep(.68, .86, folded) * smoothstep(.54, .8, detail);
          float alpha = liquid * sparkle * .13;
          gl_FragColor = vec4(vec3(alpha), alpha);
        }
      `);

      if (vertexShader && fragmentShader) {
        causticProgram = gl.createProgram();
        if (causticProgram) {
          gl.attachShader(causticProgram, vertexShader);
          gl.attachShader(causticProgram, fragmentShader);
          gl.linkProgram(causticProgram);
          if (!gl.getProgramParameter(causticProgram, gl.LINK_STATUS)) causticProgram = null;
        }
      }

      if (causticProgram) {
        const vertices = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, vertices);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        gl.useProgram(causticProgram);
        const position = gl.getAttribLocation(causticProgram, 'aPosition');
        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
        causticTime = gl.getUniformLocation(causticProgram, 'uTime');
        causticTilt = gl.getUniformLocation(causticProgram, 'uTilt');
        causticResolution = gl.getUniformLocation(causticProgram, 'uResolution');
      }
    }

    const drawCaustics = (time: number) => {
      if (!gl || !causticCanvas || !causticProgram) return;
      if (time - lastCausticTime < 33) return;
      lastCausticTime = time;
      const bounds = section.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 1.25, 1200 / Math.max(bounds.width, 1));
      const width = Math.max(1, Math.round(bounds.width * ratio));
      const height = Math.max(1, Math.round(bounds.height * ratio));
      if (causticCanvas.width !== width || causticCanvas.height !== height) {
        causticCanvas.width = width;
        causticCanvas.height = height;
        gl.viewport(0, 0, width, height);
      }
      gl.useProgram(causticProgram);
      if (causticTime) gl.uniform1f(causticTime, time * .001);
      if (causticTilt) gl.uniform2f(causticTilt, currentX, currentY);
      if (causticResolution) gl.uniform2f(causticResolution, width, height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };

    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const drawSurface = (time: number) => {
      const step = Math.min(2, lastFrameTime ? (time - lastFrameTime) / 16.667 : 1);
      lastFrameTime = time;
      const center = baseSurface - currentY * 34;
      const slope = currentX * 105;
      let moving = false;
      const previousHeights = [...surfaceHeights];

      for (let index = 0; index <= surfaceSegments; index += 1) {
        const fraction = index / surfaceSegments;
        const baseWave = -Math.sin(fraction * Math.PI * 6) * 18;
        const ambientWave = Math.sin(time * 0.00035 - fraction * 4.5) * 3.2
          + Math.sin(time * 0.00022 + fraction * 8.5) * 1.4;
        const desired = center + baseWave - (fraction - 0.5) * slope + ambientWave;
        const height = surfaceHeights[index];
        const left = previousHeights[Math.max(0, index - 1)];
        const right = previousHeights[Math.min(surfaceSegments, index + 1)];
        const spring = (desired - height) * 0.045;
        const neighborPull = ((left + right) * 0.5 - height) * 0.13;
        surfaceVelocities[index] = (surfaceVelocities[index] + (spring + neighborPull) * step) * Math.pow(0.935, step);
        surfaceHeights[index] += surfaceVelocities[index] * step;

        if (Math.abs(surfaceVelocities[index]) > 0.08 || Math.abs(desired - surfaceHeights[index]) > 0.7) moving = true;
      }

      const segmentWidth = 4320 / surfaceSegments;
      let line = `M 0 ${surfaceHeights[0].toFixed(2)}`;
      for (let index = 0; index < surfaceSegments; index += 1) {
        const startX = index * segmentWidth;
        const endX = (index + 1) * segmentWidth;
        const before = surfaceHeights[Math.max(0, index - 1)];
        const start = surfaceHeights[index];
        const end = surfaceHeights[index + 1];
        const after = surfaceHeights[Math.min(surfaceSegments, index + 2)];
        const firstControl = start + (end - before) / 6;
        const secondControl = end - (after - start) / 6;
        line += ` C ${(startX + segmentWidth / 3).toFixed(2)} ${firstControl.toFixed(2)} ${(endX - segmentWidth / 3).toFixed(2)} ${secondControl.toFixed(2)} ${endX.toFixed(2)} ${end.toFixed(2)}`;
      }

      liquidSurface?.setAttribute('d', `${line} L 4320 800 L 0 800 Z`);
      drawCaustics(time);
      return moving;
    };

    const easeTilt = () => {
      currentX += (targetX - currentX) * 0.12;
      currentY += (targetY - currentY) * 0.12;
      section.style.setProperty('--tilt-x', currentX.toFixed(3));
      section.style.setProperty('--tilt-y', currentY.toFixed(3));
      const surfaceMoving = drawSurface(performance.now());

      if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002 || surfaceMoving || sectionVisible) {
        frame = requestAnimationFrame(easeTilt);
      } else {
        frame = 0;
        lastFrameTime = 0;
      }
    };

    const animateLiquid = () => {
      if (!frame) frame = requestAnimationFrame(easeTilt);
    };

    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.gamma === null || event.beta === null) return;
      lastSensorEvent = performance.now();
      baselineGamma ??= event.gamma;
      baselineBeta ??= event.beta;
      targetX = clamp((event.gamma - baselineGamma) / 22);
      targetY = clamp((event.beta - baselineBeta) / 25);
      animateLiquid();
    };

    const onPointerMove = (event: PointerEvent) => {
      // Use direct touch/pen/mouse movement when motion sensors are blocked
      // or unavailable. Sensor data takes priority whenever it is flowing.
      if (performance.now() - lastSensorEvent < 1000 || !section) return;
      const bounds = section.getBoundingClientRect();
      targetX = clamp(((event.clientX - bounds.left) / bounds.width - 0.5) * 1.6);
      targetY = clamp(((event.clientY - bounds.top) / bounds.height - 0.5) * 1.2);
      animateLiquid();
    };

    const settleLiquid = () => {
      if (performance.now() - lastSensorEvent < 1000) return;
      targetX = 0;
      targetY = 0;
      animateLiquid();
    };

    if (mobileViewport && window.isSecureContext && orientationApi) {
      // Browsers that have already granted motion access deliver events
      // automatically. No permission prompt or on-page enable button.
      window.addEventListener('deviceorientation', onOrientation, { passive: true });
    }

    section.addEventListener('pointermove', onPointerMove, { passive: true });
    section.addEventListener('pointerup', settleLiquid, { passive: true });
    section.addEventListener('pointerleave', settleLiquid, { passive: true });
    section.addEventListener('pointercancel', settleLiquid, { passive: true });

    if ('IntersectionObserver' in window) {
      const liquidObserver = new IntersectionObserver(([entry]) => {
        sectionVisible = entry.isIntersecting;
        if (sectionVisible) animateLiquid();
        else if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
          lastFrameTime = 0;
        }
      }, { rootMargin: '80px' });
      liquidObserver.observe(section);
    } else {
      sectionVisible = true;
      animateLiquid();
    }
  }
</script>

<style>
  .manifesto {
    position: relative;
    overflow: visible;
    isolation: isolate;
    perspective: 1100px;
    transform-style: preserve-3d;
    --tilt-x: 0;
    --tilt-y: 0;
    min-height: clamp(32rem, 43vw, 37rem);
    padding-block: calc(var(--section-gap) * .55) calc(var(--section-gap) * 1.1);
    background: transparent;
  }

  /* ---------- A responsive pool of flavour-matched juice ---------- */
  .manifesto__juice-stage {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .manifesto__juice-wave {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    width: 300vw;
    max-width: none;
    height: 100%;
    overflow: visible;
    will-change: transform;
    translate: calc(var(--tilt-x) * 4px) calc(var(--tilt-y) * -3px) -16px;
  }

  .manifesto__juice-fill {
    fill: url(#manifesto-juice-gradient);
  }

  .manifesto__liquid-light {
    position: absolute;
    z-index: 1;
    inset: 38% 0 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 54% 34% at 48% 0%, rgb(255 255 255 / .1), transparent 92%),
      linear-gradient(180deg, rgb(255 255 255 / .06), transparent 36%, rgb(42 30 18 / .04));
    mix-blend-mode: soft-light;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 16%);
    background-size: 118% 120%, 100% 100%;
    animation: liquid-caustics 18s ease-in-out infinite alternate;
    transform: translate3d(calc(var(--tilt-x) * 12px), calc(var(--tilt-y) * 8px), 0);
  }

  @keyframes liquid-caustics {
    from { background-position: 0 0, 0 0; }
    to { background-position: 100% 30%, 0 0; }
  }

  .manifesto__liquid-bubbles {
    position: absolute;
    z-index: 2;
    inset: 38% 0 0;
    overflow: hidden;
    pointer-events: none;
    transform: translate3d(calc(var(--tilt-x) * 16px), calc(var(--tilt-y) * 10px), 0);
    transition: transform 120ms linear;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%);
    mask-image: linear-gradient(to bottom, transparent, #000 10%);
  }

  .manifesto__liquid-caustics {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: .42;
    pointer-events: none;
    mix-blend-mode: screen;
    filter: blur(3px);
  }

  .manifesto__liquid-bubble {
    position: absolute;
    left: var(--x);
    bottom: -.75rem;
    width: var(--size);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / .32);
    border-radius: 50%;
    background: radial-gradient(circle at 31% 26%, rgb(255 255 255 / .42) 0 8%, rgb(255 255 255 / .08) 32%, transparent 75%);
    box-shadow: inset -1px -1px 2px rgb(33 27 20 / .1), 0 0 5px rgb(255 255 255 / .1);
    opacity: 0;
    will-change: transform, opacity;
    animation: liquid-rise var(--duration) linear var(--delay) infinite;
  }

  @keyframes liquid-rise {
    0% { transform: translate3d(0, 0, 0) scale(.7); opacity: 0; }
    10% { opacity: .72; }
    45% { transform: translate3d(calc(var(--drift) * -.35), -18rem, 0) scale(1); opacity: .7; }
    75% { transform: translate3d(calc(var(--drift) * .3), -31rem, 0) scale(.9); opacity: .54; }
    100% { transform: translate3d(var(--drift), -44rem, 0) scale(.72); opacity: 0; }
  }

  /* ---------- Content ---------- */
  .manifesto__content {
    position: relative;
    z-index: 3;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    transform-style: preserve-3d;
  }

  .manifesto__inner {
    display: grid;
    justify-items: center;
    gap: clamp(.65rem, 1.5vw, 1.15rem);
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
    padding-block: clamp(1.8rem, 4vw, 3.4rem) 0;
    text-align: center;
  }

  .manifesto__eyebrow {
    justify-content: center;
  }

  .manifesto__title {
    font-size: clamp(3.8rem, 7.4vw, 6.75rem);
    line-height: var(--leading-none);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    transform: translate3d(calc(var(--tilt-x) * -4px), calc(var(--tilt-y) * -3px), 30px);
  }

  .manifesto__line {
    display: block;
  }

  .manifesto__line--accent em {
    font-size: 1.32em;
    font-weight: 400;
    text-transform: none;
    color: white;
    text-shadow: 0 .12em .42em rgb(0 0 0 / .14);
  }

  .manifesto__line em {
    font-style: italic;
  }

  .manifesto__body {
    font-size: var(--text-md);
    color: var(--ink-900);
    max-width: 42ch;
    text-shadow: 0 1px rgb(255 255 255 / .22);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto__liquid-light,
    .manifesto__liquid-bubble { animation: none; }
    .manifesto__liquid-bubble { top: var(--still-y); bottom: auto; opacity: .48; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 48rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 29rem;
      touch-action: pan-y;
    }
    .manifesto__juice-wave { top: calc(-12% + var(--tilt-y) * -4px); height: calc(118% + 8px); }
    .manifesto__liquid-bubble:nth-child(5n) { display: none; }
    .manifesto__liquid-light { top: 33%; }
    .manifesto__liquid-bubbles { top: 33%; }
  }

  @media (max-width: 30rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 27rem;
    }
    .manifesto__inner {
      gap: var(--space-s);
    }
    .manifesto__title {
      font-size: var(--text-2xl);
    }
    .manifesto__body {
      font-size: var(--text-base);
    }
    .manifesto { padding-bottom: 8rem; }
    .manifesto__inner { width: calc(100% - 1rem); padding-top: 1.25rem; }
  }
</style>
