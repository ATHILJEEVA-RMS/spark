---
/* ============================================================
   MANIFESTO — the brand's opening argument.
   Editorial type over a flavour-matched, carbonated juice pool.
   Copy comes from site.ts.
   ============================================================ */
import { manifesto } from '../../data/site';
import Eyebrow from '../ui/Eyebrow.astro';

const [l1, l2] = manifesto.heading;
const random = (seed: number) => {
  const value = Math.sin(seed * 78.233) * 43758.5453;
  return value - Math.floor(value);
};
const bubbleStreams = [8, 17, 29, 43, 57, 71, 83, 92];
const liquidBubbles = Array.from({ length: 112 }, (_, index) => {
  const size = 2 + Math.pow(random(index + 91), 1.7) * 8;
  const duration = 12.5 - size * .55 + random(index + 51) * 2.5;
  return {
    x: Math.max(2, Math.min(98, bubbleStreams[index % bubbleStreams.length] + (random(index + 4) - .5) * 13)).toFixed(1),
    size: size.toFixed(1),
    duration: duration.toFixed(2),
    delay: (-(random(index + 127) * duration)).toFixed(2),
    drift: Math.round((random(index + 173) - .5) * 28),
    stillY: (4 + random(index + 219) * 90).toFixed(1),
  };
});
---

<section class="manifesto" id="story">
  {/* A natural continuation of the hero's soft flavour fade */}
  <div class="manifesto__juice-stage" aria-hidden="true">
    <svg class="manifesto__juice-wave" viewBox="0 0 4320 800" preserveAspectRatio="none">
      <defs>
        <linearGradient id="manifesto-juice-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 43%, var(--active-flavour-soft))" />
          <stop offset="40%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 62%, var(--active-flavour-soft))" />
          <stop offset="100%" stop-color="color-mix(in oklab, var(--active-flavour-primary) 78%, var(--active-flavour-soft))" />
        </linearGradient>
        <pattern id="manifesto-juice-pattern" width="720" height="800" patternUnits="userSpaceOnUse">
          <path class="manifesto__juice-fill" d="M0 245 C120 229 240 229 360 245 S600 261 720 245 L720 800 L0 800Z" />
        </pattern>
      </defs>
      <rect width="4320" height="800" fill="url(#manifesto-juice-pattern)" />
    </svg>
    <div class="manifesto__liquid-light"></div>
    <div class="manifesto__liquid-bubbles">
      {liquidBubbles.map((bubble) => (
        <span
          class="manifesto__liquid-bubble"
          style={`--x:${bubble.x}%;--size:${bubble.size}px;--duration:${bubble.duration}s;--delay:${bubble.delay}s;--drift:${bubble.drift}px;--still-y:${bubble.stillY}%`}
        />
      ))}
    </div>
  </div>
  <div class="manifesto__content">
    <div class="manifesto__inner" data-reveal="up">
      <Eyebrow class="manifesto__eyebrow">{manifesto.eyebrow}</Eyebrow>

      <h2 class="manifesto__title">
        <span class="manifesto__line">
          {l1}
        </span>
        <span class="manifesto__line manifesto__line--accent">
          <em>{l2}</em>
        </span>
      </h2>

      <p class="manifesto__body" data-reveal="up" style="--reveal-delay: 160ms">
        {manifesto.body}
      </p>

    </div>
  </div>
  <button class="manifesto__tilt" type="button" data-tilt-enable hidden>
    Enable tilt
  </button>
</section>

<script>
  type OrientationEventWithPermission = typeof DeviceOrientationEvent & {
    requestPermission?: () => Promise<'granted' | 'denied'>;
  };

  const section = document.querySelector<HTMLElement>('#story');
  const tiltButton = section?.querySelector<HTMLButtonElement>('[data-tilt-enable]');
  const orientationApi = window.DeviceOrientationEvent as OrientationEventWithPermission | undefined;
  const mobileViewport = window.matchMedia('(max-width: 48rem)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && mobileViewport && !reducedMotion && window.isSecureContext && orientationApi) {
    let baselineGamma: number | undefined;
    let baselineBeta: number | undefined;
    let frame = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const easeTilt = () => {
      currentX += (targetX - currentX) * 0.12;
      currentY += (targetY - currentY) * 0.12;
      section.style.setProperty('--tilt-x', currentX.toFixed(3));
      section.style.setProperty('--tilt-y', currentY.toFixed(3));

      if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002) {
        frame = requestAnimationFrame(easeTilt);
      } else {
        frame = 0;
      }
    };

    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.gamma === null || event.beta === null) return;
      baselineGamma ??= event.gamma;
      baselineBeta ??= event.beta;
      targetX = clamp((event.gamma - baselineGamma) / 22);
      targetY = clamp((event.beta - baselineBeta) / 25);

      if (!frame) frame = requestAnimationFrame(easeTilt);
    };

    const enableTilt = () => {
      window.addEventListener('deviceorientation', onOrientation, { passive: true });
      section.dataset.tiltEnabled = 'true';
      if (tiltButton) tiltButton.hidden = true;
    };

    if (typeof orientationApi.requestPermission === 'function') {
      if (tiltButton) {
        tiltButton.hidden = false;
        tiltButton.addEventListener('click', async () => {
          try {
            if (await orientationApi.requestPermission?.() === 'granted') enableTilt();
            else tiltButton.hidden = true;
          } catch {
            tiltButton.hidden = true;
          }
        }, { once: true });
      }
    } else {
      enableTilt();
    }
  }
</script>

<style>
  .manifesto {
    position: relative;
    overflow: visible;
    isolation: isolate;
    perspective: 1100px;
    transform-style: preserve-3d;
    --tilt-x: 0;
    --tilt-y: 0;
    min-height: clamp(36rem, 48vw, 40rem);
    padding-block: calc(var(--section-gap) * .55) calc(var(--section-gap) * 1.1);
    background: transparent;
  }

  /* ---------- A responsive pool of flavour-matched juice ---------- */
  .manifesto__juice-stage {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .manifesto__juice-wave {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    width: 300vw;
    max-width: none;
    height: 100%;
    overflow: visible;
    will-change: transform;
    animation: juice-wave-roll 28s linear infinite;
    translate: calc(var(--tilt-x) * 10px) calc(var(--tilt-y) * -4px) -16px;
  }

  .manifesto__juice-fill {
    fill: url(#manifesto-juice-gradient);
  }

  .manifesto__liquid-light {
    position: absolute;
    z-index: 1;
    inset: 31% 0 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 34% 55% at 10% 20%, rgb(255 255 255 / .2), transparent 80%),
      radial-gradient(ellipse 30% 70% at 88% 35%, rgb(255 255 255 / .16), transparent 85%),
      linear-gradient(180deg, rgb(255 255 255 / .12), transparent 34%, rgb(0 0 0 / .08));
    mix-blend-mode: soft-light;
    transform: translate3d(calc(var(--tilt-x) * 5px), calc(var(--tilt-y) * 4px), 0);
  }

  .manifesto__liquid-bubbles {
    position: absolute;
    z-index: 2;
    inset: 31% 0 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%);
    mask-image: linear-gradient(to bottom, transparent, #000 10%);
  }

  .manifesto__liquid-bubble {
    position: absolute;
    left: var(--x);
    bottom: -.75rem;
    width: var(--size);
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / .64);
    border-radius: 50%;
    background: radial-gradient(circle at 29% 26%, rgb(255 255 255 / .88) 0 10%, rgb(255 255 255 / .1) 30%, transparent 75%);
    box-shadow: inset -1px -1px 2px rgb(33 27 20 / .13), 0 0 5px rgb(255 255 255 / .19);
    opacity: 0;
    will-change: transform, opacity;
    animation: liquid-rise var(--duration) linear var(--delay) infinite;
  }

  @keyframes liquid-rise {
    0% { transform: translate3d(0, 0, 0) scale(.7); opacity: 0; }
    10% { opacity: .72; }
    45% { transform: translate3d(calc(var(--drift) * -.35), -18rem, 0) scale(1); opacity: .7; }
    75% { transform: translate3d(calc(var(--drift) * .3), -31rem, 0) scale(.9); opacity: .54; }
    100% { transform: translate3d(var(--drift), -44rem, 0) scale(.72); opacity: 0; }
  }

  /* ---------- Content ---------- */
  .manifesto__content {
    position: relative;
    z-index: 3;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    transform-style: preserve-3d;
  }

  .manifesto__inner {
    display: grid;
    justify-items: center;
    gap: clamp(.65rem, 1.5vw, 1.15rem);
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
    padding-block: clamp(1.8rem, 4vw, 3.4rem) 0;
    text-align: center;
  }

  .manifesto__eyebrow {
    justify-content: center;
  }

  .manifesto__title {
    font-size: clamp(3.8rem, 7.4vw, 6.75rem);
    line-height: var(--leading-none);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    transform: translate3d(calc(var(--tilt-x) * -4px), calc(var(--tilt-y) * -3px), 30px);
  }

  .manifesto__line {
    display: block;
  }

  .manifesto__line--accent em {
    font-size: 1.32em;
    font-weight: 400;
    text-transform: none;
    color: white;
    text-shadow: 0 .12em .42em rgb(0 0 0 / .14);
  }

  .manifesto__line em {
    font-style: italic;
  }

  .manifesto__body {
    font-size: var(--text-md);
    color: var(--ink-900);
    max-width: 42ch;
    text-shadow: 0 1px rgb(255 255 255 / .22);
  }

  .manifesto__tilt {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 1.15rem;
    padding: .55rem .8rem;
    border: 1px solid rgb(255 255 255 / .62);
    border-radius: 999px;
    background: rgb(255 255 255 / .62);
    box-shadow: 0 5px 18px rgb(0 0 0 / .08);
    color: var(--ink-900);
    font: 600 .72rem/1 var(--font-body);
    letter-spacing: .02em;
    backdrop-filter: blur(10px);
    cursor: pointer;
    transform: translateX(-50%);
  }

  .manifesto__tilt[hidden] { display: none; }

  @keyframes juice-wave-roll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333333%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto__juice-wave,
    .manifesto__liquid-bubble { animation: none; }
    .manifesto__liquid-bubble { top: var(--still-y); bottom: auto; opacity: .48; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 48rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 32rem;
    }
    .manifesto__juice-wave { top: calc(-18.5% + var(--tilt-y) * -4px); height: calc(125% + 8px); }
    .manifesto__liquid-light,
    .manifesto__liquid-bubbles { top: 20%; }
    .manifesto__tilt {
      top: .8rem;
      right: var(--gutter);
      bottom: auto;
      left: auto;
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .manifesto {
      padding-block: calc(var(--section-gap) * .4);
      min-height: 31rem;
    }
    .manifesto__inner {
      gap: var(--space-s);
    }
    .manifesto__title {
      font-size: var(--text-2xl);
    }
    .manifesto__body {
      font-size: var(--text-base);
    }
    .manifesto { padding-bottom: 8rem; }
    .manifesto__inner { width: calc(100% - 1rem); padding-top: 1.25rem; }
  }
</style>
