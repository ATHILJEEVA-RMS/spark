---
/* A considered pause in the home page: one clear promise, followed by
   three quick paths into the flavours people may already love. */
import { future } from '../../data/site';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';

const occasions = [
  { label: 'A bright break', flavour: 'Orange', href: '/spark/flavours/orange', color: 'var(--orange)' },
  { label: 'A tropical catch-up', flavour: 'Mango', href: '/spark/flavours/mango', color: 'var(--mango)' },
  { label: 'A familiar favourite', flavour: 'Cola', href: '/spark/flavours/cola', color: 'var(--cola)' },
];
const [h1, h2] = future.heading;
---

<Section id="coming-soon" spacing="tight">
  <div class="future" data-reveal="fade">
    <span class="future__glow future__glow--one" aria-hidden="true"></span>
    <span class="future__glow future__glow--two" aria-hidden="true"></span>
    <span class="future__accent future__accent--one" aria-hidden="true"></span>
    <span class="future__accent future__accent--two" aria-hidden="true"></span>

    <div class="future__inner">
      <div class="future__copy">
        <Eyebrow class="future__eyebrow">{future.eyebrow}</Eyebrow>
        <h2 class="future__title" data-reveal="up">
          <span>{h1}</span>
          <span class="future__title-accent"><em>{h2}</em></span>
        </h2>
        <div class="future__body" data-reveal="up" style="--reveal-delay: 100ms">
          {future.body.map((line) => <p>{line}</p>)}
        </div>
        <div class="future__action" data-reveal="up" style="--reveal-delay: 160ms">
          <Button href={future.cta.href} variant="clay" size="lg">{future.cta.label}</Button>
        </div>
      </div>

      <div class="future__choices" data-reveal="up" style="--reveal-delay: 120ms">
        <p class="future__choices-heading">Pick your kind of break</p>
        {occasions.map((occasion, i) => (
          <a href={occasion.href} class="future__occasion clay-sm" style={`--moment-color: ${occasion.color}`}>
            <span class="future__occasion-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="future__occasion-copy">
              <span>{occasion.label}</span>
              <strong>{occasion.flavour}</strong>
            </span>
            <span class="future__occasion-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  .future {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgb(255 255 255 / 0.78);
    border-radius: var(--radius-clay);
    background:
      radial-gradient(60% 90% at 4% 0%, color-mix(in oklab, var(--mango) 25%, transparent), transparent 72%),
      radial-gradient(70% 90% at 100% 100%, color-mix(in oklab, var(--litchi) 27%, transparent), transparent 70%),
      linear-gradient(135deg, var(--cream-50), var(--cream-100) 58%, var(--cream-200));
    box-shadow: 0 20px 55px rgb(26 20 16 / 0.07), inset 0 1px 0 rgb(255 255 255 / 0.72);
  }

  .future__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    max-width: 72rem;
    margin-inline: auto;
  }

  .future__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
  }

  .future__eyebrow { justify-content: flex-start; }

  .future__title {
    font-size: clamp(2.8rem, 5.1vw, 4.75rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .future__title span { display: block; }

  .future__title-accent em {
    color: var(--orange-deep);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
  }

  .future__body {
    display: grid;
    gap: 0.2rem;
    max-width: 38ch;
    color: var(--ink-700);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  .future__action { margin-top: var(--space-2xs); }

  .future__choices {
    display: grid;
    gap: var(--space-xs);
  }

  .future__choices-heading {
    margin-bottom: var(--space-2xs);
    color: var(--ink-500);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .future__occasion {
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: var(--space-s);
    min-height: 5.4rem;
    padding: var(--space-xs) var(--space-s);
    border: 1px solid rgb(255 255 255 / 0.78);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--cream-50) 79%, transparent);
    color: var(--ink-900);
    box-shadow: 0 8px 22px rgb(26 20 16 / 0.06), inset 0 1px 0 rgb(255 255 255 / 0.82);
    transition: translate 220ms var(--ease-out-expo), box-shadow 220ms var(--ease-out-expo), background-color 220ms ease;
  }

  .future__occasion:hover,
  .future__occasion:focus-visible {
    translate: 0 -2px;
    background: var(--cream-50);
    box-shadow: 0 14px 28px rgb(26 20 16 / 0.1), inset 0 1px 0 white;
  }

  .future__occasion-index {
    display: grid;
    place-items: center;
    width: 2.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--moment-color) 17%, white);
    color: color-mix(in oklab, var(--moment-color) 76%, var(--ink-900));
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .future__occasion-copy {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-500);
    font-size: var(--text-xs);
  }

  .future__occasion-copy strong {
    color: var(--ink-900);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.1;
  }

  .future__occasion-arrow {
    display: grid;
    place-items: center;
    justify-self: end;
    width: 2.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--moment-color) 14%, white);
    color: color-mix(in oklab, var(--moment-color) 76%, var(--ink-900));
    font-size: 1.15rem;
    transition: translate 220ms var(--ease-out-expo);
  }

  .future__occasion:hover .future__occasion-arrow,
  .future__occasion:focus-visible .future__occasion-arrow { translate: 2px -2px; }

  .future__glow {
    position: absolute;
    z-index: -1;
    width: 24rem;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.48;
    animation: future-pulse 12s ease-in-out infinite alternate;
  }

  .future__glow--one {
    top: -60%;
    left: -12%;
    background: color-mix(in oklab, var(--mango) 35%, transparent);
  }

  .future__glow--two {
    right: -12%;
    bottom: -70%;
    background: color-mix(in oklab, var(--litchi) 38%, transparent);
    animation-delay: -6s;
  }

  .future__accent {
    position: absolute;
    z-index: 0;
    width: 1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, white 0 12%, var(--mango) 72%);
    box-shadow: 0 4px 12px rgb(26 20 16 / 0.12);
    animation: future-drift 7s ease-in-out infinite alternate;
  }

  .future__accent--one { top: 16%; left: 41%; }
  .future__accent--two { right: 5%; bottom: 16%; width: 0.7rem; animation-delay: -3s; }

  @keyframes future-pulse {
    from { scale: 0.94; opacity: 0.36; }
    to { scale: 1.06; opacity: 0.58; }
  }

  @keyframes future-drift {
    from { translate: 0 0; }
    to { translate: 0 -10px; }
  }

  @media (max-width: 58rem) {
    .future__inner { grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr); gap: var(--space-l); }
    .future__title { font-size: clamp(2.6rem, 5.6vw, 3.8rem); }
    .future__occasion { grid-template-columns: 2.5rem minmax(0, 1fr) 2.4rem; gap: var(--space-xs); }
  }

  @media (max-width: 46rem) {
    .future { padding: var(--space-l) var(--space-s); }
    .future__inner { grid-template-columns: 1fr; gap: var(--space-l); }
    .future__title { font-size: clamp(2.8rem, 11vw, 4.2rem); }
    .future__choices { gap: var(--space-2xs); }
    .future__choices-heading { margin-bottom: 0; }
    .future__accent--one { top: 12%; right: 10%; left: auto; }
  }

  @media (max-width: 30rem) {
    .future { padding: var(--space-m) var(--space-s); border-radius: var(--radius-lg); }
    .future__inner { gap: var(--space-m); }
    .future__title { font-size: clamp(2.65rem, 12vw, 3.25rem); }
    .future__occasion { min-height: 4.9rem; padding-inline: var(--space-xs); }
    .future__accent--two { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .future__glow,
    .future__accent { animation: none; }
    .future__occasion,
    .future__occasion-arrow { transition: none; }
  }
</style>
