---
import { ctaSection } from '../../data/site';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';

const paths = [
  {
    number: '01',
    label: 'Looking for a drink?',
    title: 'Find SPARK near you',
    description: 'Tell us your city and the flavour you’d like to try.',
    href: ctaSection.primaryCta.href,
    color: 'var(--orange)',
  },
  {
    number: '02',
    label: 'For shops and distributors',
    title: 'Stock SPARK',
    description: 'Share your shop or territory with our team.',
    href: ctaSection.secondaryCta.href,
    color: 'var(--litchi)',
  },
];
---

<Section id="stockists" spacing="tight">
  <div class="cta" data-reveal="fade">
    <div class="cta__inner">
      <div class="cta__copy" data-reveal="up">
        <Eyebrow>{ctaSection.eyebrow}</Eyebrow>
        <h2 class="cta__title" id="stockists-title">
          <span>Which SPARK</span>
          <span class="cta__title-accent"><em>will you try?</em></span>
        </h2>
        <p class="cta__lede">Eight sparkling flavours. Find your favourite, or bring SPARK to your shelves.</p>
      </div>

      <div class="cta__choices" aria-labelledby="stockists-title">
        <p class="cta__choices-heading">Choose your next step</p>
        {paths.map((path, index) => (
          <a
            class="cta__choice"
            href={path.href}
            style={`--choice-color: ${path.color}; --reveal-delay: ${index * 80}ms;`}
            data-reveal="up"
          >
            <span class="cta__choice-number" aria-hidden="true">{path.number}</span>
            <span class="cta__choice-copy">
              <span class="cta__choice-label">{path.label}</span>
              <strong>{path.title}</strong>
              <span class="cta__choice-description">{path.description}</span>
            </span>
            <span class="cta__choice-action" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2.5 8h10M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 4.5vw, 4rem);
    border: 1px solid rgb(255 255 255 / 0.78);
    border-radius: var(--radius-clay);
    background:
      radial-gradient(60% 100% at 2% 0%, color-mix(in oklab, var(--orange-soft) 65%, transparent), transparent 75%),
      radial-gradient(65% 90% at 100% 100%, color-mix(in oklab, var(--litchi) 18%, transparent), transparent 72%),
      linear-gradient(135deg, var(--cream-50), var(--cream-100) 65%, var(--cream-200));
    box-shadow: 0 16px 42px rgb(26 20 16 / 0.055), inset 0 1px 0 rgb(255 255 255 / 0.72);
  }
  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    max-width: 72rem;
    margin-inline: auto;
  }
  .cta__copy { display: grid; justify-items: start; gap: var(--space-s); }
  .cta__title {
    font-size: clamp(2.8rem, 5vw, 4.65rem);
    line-height: 0.96;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }
  .cta__title span { display: block; }
  .cta__title-accent em {
    color: var(--orange-deep);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
  }
  .cta__lede {
    max-width: 34ch;
    color: var(--ink-700);
    font-size: var(--text-base);
    line-height: 1.6;
  }
  .cta__choices { display: grid; gap: var(--space-xs); }
  .cta__choices-heading {
    margin: 0 0 var(--space-2xs);
    color: var(--ink-500);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .cta__choice {
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s);
    min-height: 6rem;
    padding: var(--space-s);
    border: 1px solid rgb(255 255 255 / 0.82);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--cream-50) 82%, transparent);
    color: var(--ink-900);
    box-shadow: 0 7px 20px rgb(26 20 16 / 0.045), inset 0 1px 0 rgb(255 255 255 / 0.82);
    transition: translate 220ms var(--ease-out-expo), box-shadow 220ms var(--ease-out-expo), background-color 220ms ease;
  }
  .cta__choice:hover, .cta__choice:focus-visible {
    translate: 0 -2px;
    background: var(--cream-50);
    box-shadow: 0 13px 27px rgb(26 20 16 / 0.085), inset 0 1px 0 white;
  }
  .cta__choice:focus-visible { outline: 2px solid var(--choice-color); outline-offset: 3px; }
  .cta__choice-number {
    display: grid;
    place-items: center;
    width: 2.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--choice-color) 18%, white);
    color: color-mix(in oklab, var(--choice-color) 75%, var(--ink-900));
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .cta__choice-copy { display: grid; gap: 0.12rem; }
  .cta__choice-label { color: var(--ink-500); font-size: var(--text-xs); }
  .cta__choice-copy strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }
  .cta__choice-description { color: var(--ink-500); font-size: var(--text-xs); line-height: 1.45; }
  .cta__choice-action {
    display: grid;
    place-items: center;
    width: 2.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in oklab, var(--choice-color) 14%, white);
    color: color-mix(in oklab, var(--choice-color) 75%, var(--ink-900));
    transition: translate 220ms var(--ease-out-expo), background-color 220ms ease;
  }
  .cta__choice-action svg { transition: translate 220ms var(--ease-out-expo); }
  .cta__choice:hover .cta__choice-action svg,
  .cta__choice:focus-visible .cta__choice-action svg { translate: 3px 0; }
  .cta__choice:hover .cta__choice-action,
  .cta__choice:focus-visible .cta__choice-action { background: color-mix(in oklab, var(--choice-color) 20%, white); }
  @media (max-width: 58rem) {
    .cta__inner { grid-template-columns: minmax(0, 0.85fr) minmax(19rem, 1.15fr); gap: var(--space-l); }
    .cta__title { font-size: clamp(2.55rem, 5.7vw, 3.8rem); }
    .cta__choice { grid-template-columns: 2.5rem minmax(0, 1fr) 2.4rem; gap: var(--space-xs); }
    .cta__choice-action { width: 2.4rem; }
  }
  @media (max-width: 46rem) {
    .cta { padding: var(--space-l) var(--space-s); }
    .cta__inner { grid-template-columns: 1fr; gap: var(--space-l); }
    .cta__title {
      font-family: var(--font-sans);
      font-size: clamp(2.2rem, 8vw, 3.4rem);
      font-weight: 600;
      line-height: 1.03;
      letter-spacing: -0.055em;
    }
    .cta__title-accent em {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 500;
      letter-spacing: -0.045em;
    }
  }
  @media (max-width: 30rem) {
    .cta { padding: var(--space-m) var(--space-s); border-radius: var(--radius-lg); }
    .cta__inner { gap: var(--space-m); }
    .cta__title { font-size: clamp(2rem, 8.8vw, 2.7rem); }
    .cta__choice { min-height: 5.5rem; padding: var(--space-xs); }
    .cta__choice-description { max-width: 29ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__choice, .cta__choice-action svg { transition: none; }
  }
</style>
