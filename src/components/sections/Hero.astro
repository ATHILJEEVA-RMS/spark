---
/* The product and colour world transition together; visitors can pause
   rotation or select a flavour from the desktop rail. */
import { hero } from '../../data/site';
import { getFlavours } from '../../data/flavours';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import CanStage from '../CanStage.astro';

const flavours = await getFlavours();
const featured = flavours.find((f) => f.data.featured) ?? flavours[0];
const initial = featured.data.colors;
const [l1, l2, l3] = hero.title;
const pad = (n: number) => String(n).padStart(2, '0');

/* Flavour colour data serialised for the client — drives the
   smooth colour-world transitions on the whole hero. */
const flavourData = flavours.map((f) => ({
  id: f.id,
  name: f.data.name,
  mood: f.data.mood,
  order: f.data.order,
  colors: f.data.colors,
}));
---

<header
  class="hero"
  data-hero
  data-start-index={flavours.findIndex((f) => f.id === featured.id)}
  style={`--flavour-primary: ${initial.primary}; --flavour-deep: ${initial.deep}; --flavour-soft: ${initial.soft};`}
  data-flavours={JSON.stringify(flavourData)}
>
  <span class="hero__blob hero__blob--1" aria-hidden="true"></span>
  <span class="hero__blob hero__blob--2" aria-hidden="true"></span>

  <Container>
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title" data-reveal="up" style="--reveal-delay: 80ms">
          <span class="hero__title-line">{l1}</span>
          <span class="hero__title-line">{l2}</span>
          <span class="hero__title-line hero__title-line--accent"><em>{l3}</em></span>
        </h1>

        {/* Dynamic flavour badge — the only copy that changes */}
        <div class="hero__featuring" data-reveal="up" style="--reveal-delay: 160ms" data-featuring>
          <span class="hero__featuring-label">Now Featuring</span>
          <span class="hero__featuring-name" data-featuring-name>{featured.data.name}</span>
          <span class="hero__featuring-tag" data-featuring-tag>{featured.data.mood}</span>
        </div>

        <p class="hero__lede" data-reveal="up" style="--reveal-delay: 220ms">
          {hero.lede}
        </p>

        <div class="hero__actions" data-reveal="up" style="--reveal-delay: 320ms">
          <Button href={hero.primaryCta.href} variant="accent" size="lg">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="clay" size="lg">{hero.secondaryCta.label}</Button>
        </div>
      </div>

      <div class="hero__stage" data-stage>
        {
          flavours.map((f, i) => (
            <div
              class:list={['hero__stage-layer', { 'is-active': f.id === featured.id }]}
              data-layer={i}
              style={`--flavour-primary: ${f.data.colors.primary}; --flavour-deep: ${f.data.colors.deep}; --flavour-soft: ${f.data.colors.soft};`}
              aria-hidden={f.id !== featured.id ? 'true' : 'false'}
            >
              <CanStage flavour={f} variant="hero" loading={f.id === featured.id ? 'eager' : 'lazy'} />
            </div>
          ))
        }
        <span class="hero__caption" data-caption>
          <span class="hero__caption-num" data-caption-num>Nº {pad(featured.data.order)}</span>
          <span class="hero__caption-name" data-caption-name>{featured.data.name}</span>
          <span class="hero__caption-line" aria-hidden="true"></span>
          <span class="hero__caption-tag" data-caption-tag>{featured.data.mood}</span>
        </span>
      </div>
    </div>
  </Container>

  {/* flavour index rail — desktop editorial device */}
  <nav class="hero__rail" aria-label="Flavour index" data-rail>
    <ol role="list">
      {
        flavours.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['hero__rail-link', { 'is-active': f.id === featured.id }]}
              data-rail-link={i}
              style={`--flavour-primary: ${f.data.colors.primary};`}
            >
              <span class="hero__rail-num">{pad(f.data.order)}</span>
              <span class="hero__rail-name">{f.data.name}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="hero__meta">
    <span data-reveal="fade" style="--reveal-delay: 460ms">{hero.meta}</span>
  </div>
</header>

<style>
  /* Defaults for the hero's dynamic flavour palette. */
  @property --flavour-primary { syntax: '<color>'; inherits: true; initial-value: #f47b00; }
  @property --flavour-deep    { syntax: '<color>'; inherits: true; initial-value: #cf4b00; }
  @property --flavour-soft    { syntax: '<color>'; inherits: true; initial-value: #fde4cb; }

  .hero {
    --hero-switch-duration: 620ms;
    --hero-switch-easing: cubic-bezier(0.22, 0.61, 0.36, 1);
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
    overflow: clip;
  }

  /* floating clay blobs — the sanctioned decorative clay */
  .hero__blob {
    position: absolute;
    border-radius: 46% 54% 58% 42% / 52% 46% 54% 48%;
    background: linear-gradient(145deg, var(--cream-50), var(--cream-200));
    box-shadow: var(--shadow-clay);
    animation: hero-blob 9s ease-in-out infinite alternate;
  }

  .hero__blob--1 {
    width: clamp(5rem, 9vw, 9rem);
    aspect-ratio: 1;
    top: 16%;
    left: -2.5rem;
  }

  .hero__blob--2 {
    width: clamp(3.5rem, 6vw, 6rem);
    aspect-ratio: 1;
    bottom: 20%;
    left: 42%;
    animation-delay: -4s;
  }

  .hero :global(.container) {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-l);
    align-items: center;
    flex: 1;
  }

  /* ---------- Copy ---------- */
  .hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .hero__title {
    font-size: var(--text-hero);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--accent em {
    text-transform: none;
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--flavour-primary) 80%, white) 0%,
      var(--flavour-primary) 45%,
      var(--flavour-deep) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- "Now Featuring" dynamic badge ---------- */
  .hero__featuring {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-pill);
    background: linear-gradient(145deg, var(--cream-50), var(--cream-200));
    box-shadow: var(--shadow-clay-sm);
    max-width: max-content;
  }

  .hero__featuring-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__featuring-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--flavour-primary);
  }

  .hero__featuring-tag {
    font-size: var(--text-xs);
    color: var(--ink-700);
    letter-spacing: 0.02em;
  }

  .hero__featuring-tag::before {
    content: '— ';
    color: var(--ink-300);
  }

  .hero__lede {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    max-width: 38ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }

  /* Keep the primary action in lockstep with the flavour hue. A two-stop
     gradient can retain its previous deep stop for a frame during updates,
     which makes the button flash the default orange between flavours. */
  .hero__actions :global(.btn--accent) {
    background-color: var(--flavour-primary);
    background-image: linear-gradient(145deg, rgb(255 255 255 / 0.24), rgb(0 0 0 / 0.08));
    transition:
      box-shadow var(--duration-med) var(--ease-out-expo),
      translate var(--duration-med) var(--ease-out-expo);
  }

  /* ---------- Stage — stacked flavour layers ---------- */
  .hero__stage {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    margin-inline-start: calc(var(--space-3xl) * -1);
    min-height: clamp(20rem, 38vw, 32rem);
  }

  .hero__stage::before {
    content: '';
    position: absolute;
    z-index: 0;
    width: min(80%, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--flavour-primary) 22%, white) 0%, transparent 68%);
    opacity: 0;
    pointer-events: none;
  }

  .hero.is-switching .hero__stage::before {
    animation: hero-switch-glow var(--hero-switch-duration) var(--hero-switch-easing) both;
  }

  .hero__stage-layer {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translate3d(var(--hero-enter-x, 1.25rem), 0.25rem, 0) scale(0.96) rotate(var(--hero-enter-rotate, -2deg));
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity var(--hero-switch-duration) var(--hero-switch-easing),
      transform var(--hero-switch-duration) var(--hero-switch-easing),
      filter var(--hero-switch-duration) var(--hero-switch-easing);
  }

  .hero__stage-layer.is-active {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    filter: blur(0);
    pointer-events: auto;
  }

  .hero__stage-layer.is-leaving {
    opacity: 0;
    transform: translate3d(var(--hero-leave-x, -0.9rem), -0.1rem, 0) scale(0.98) rotate(var(--hero-leave-rotate, 1.5deg));
    transition-duration: 340ms, var(--hero-switch-duration), var(--hero-switch-duration);
    transition-timing-function: ease-in, var(--hero-switch-easing), var(--hero-switch-easing);
  }

  .hero__stage-layer:not(.is-active) :global(*) {
    animation-play-state: paused !important;
  }

  .hero.is-switching .hero__stage-layer :global(*) {
    animation-play-state: paused !important;
  }

  .hero__caption {
    position: absolute;
    bottom: 6%;
    right: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    z-index: 3;
  }

  .hero__caption-num {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    color: var(--flavour-primary);
  }

  .hero__caption-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
  }

  .hero__caption-line {
    width: 2.25rem;
    height: 1px;
    background: var(--ink-300);
    align-self: center;
  }

  .hero__caption-tag {
    color: var(--color-text-muted);
  }

  /* ---------- Flavour index rail ---------- */
  .hero__rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    z-index: 3;
  }

  .hero__rail ol {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .hero__rail-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--ink-300);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .hero__rail-num {
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero__rail-name {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width var(--duration-med) var(--ease-out-expo),
      opacity var(--duration-fast) ease;
  }

  .hero__rail-link:hover,
  .hero__rail-link.is-active {
    color: var(--flavour-primary);
    }

  .hero__rail-link:hover .hero__rail-name,
  .hero__rail-link.is-active .hero__rail-name {
    max-width: 8rem;
    opacity: 1;
  }

  .hero__rail-link.is-active .hero__rail-num {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* ---------- Meta strip ---------- */
  .hero__meta {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    justify-content: center;
    margin: var(--space-s) auto 0;
    padding-inline: var(--gutter);
    width: 100%;
    max-width: var(--container);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---------- Motion ---------- */
  @keyframes hero-blob {
    from { transform: translateY(0) rotate(0deg); }
    to   { transform: translateY(-22px) rotate(8deg); }
  }

  @keyframes hero-switch-glow {
    0% { opacity: 0; transform: scale(0.76); }
    38% { opacity: 0.72; }
    100% { opacity: 0; transform: scale(1.32); }
  }

  /* ---------- Responsive ---------- */
  @media (min-width: 56.001rem) {
    .hero__caption { display: none; }
  }

  @media (max-width: 80rem) {
    .hero__rail { display: none; }
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .hero__copy,
    .hero__stage {
      grid-column: 1;
      justify-items: center;
      text-align: center;
    }
    .hero__stage {
      order: -1;
      margin-inline-start: 0;
      min-height: clamp(16rem, 42vh, 24rem);
    }
    .hero__lede { margin-inline: auto; }
    .hero__caption {
      right: var(--space-s);
      bottom: -0.85rem;
    }
  }

  @media (max-width: 30rem) {
    .hero {
      padding-top: var(--space-2xl);
      padding-bottom: var(--space-s);
    }
    .hero__stage { min-height: clamp(13rem, 32svh, 18rem); }
    .hero__stage :global(.stage--hero) { width: min(65vw, 15rem); }
    .hero__featuring { display: none; }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
    .hero__meta { display: none; }
    .hero__caption-line,
    .hero__caption-tag { display: none; }
  }

  @media (max-width: 30rem) and (max-height: 46rem) {
    .hero { padding-top: 4rem; padding-bottom: 0; }
    .hero__stage { min-height: clamp(10rem, 26svh, 12rem); }
    .hero__stage :global(.stage--hero) { width: min(44vw, 10rem); }
    .hero__grid { gap: 0.5rem; }
    .hero__copy { gap: 0.375rem; }
    .hero__actions { gap: var(--space-2xs); }
    .hero__title { font-size: 2.4rem; }
    .hero__actions :global(.btn) { padding-block: 0.65em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage-layer {
      transition: opacity var(--duration-fast) ease;
      transform: none;
      filter: none;
    }
    .hero__stage-layer.is-leaving { transform: none; }
    .hero.is-switching .hero__stage::before { animation: none; }
    .hero,
    .hero__blob,
    .hero__title-line--accent em,
    .hero__badge-dot,
    .hero__featuring-name,
    .hero__caption-num {
      transition: none;
    }
  }
</style>

<script>
  import { formatHslPalette, mixHslPalette, toHslPalette, type FlavourColors } from '../../scripts/flavour-colors';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const flavours = JSON.parse(hero.dataset.flavours || '[]') as Array<{
      name: string;
      mood: string;
      order: number;
      colors: FlavourColors;
    }>;
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-layer]'));
    const railLinks = Array.from(hero.querySelectorAll<HTMLElement>('[data-rail-link]'));
    const stage = hero.querySelector<HTMLElement>('[data-stage]');
    const nameEl = hero.querySelector<HTMLElement>('[data-featuring-name]');
    const tagEl = hero.querySelector<HTMLElement>('[data-featuring-tag]');
    const featuringEl = hero.querySelector<HTMLElement>('[data-featuring]');
    const captionEl = hero.querySelector<HTMLElement>('[data-caption]');
    const captionNum = hero.querySelector<HTMLElement>('[data-caption-num]');
    const captionName = hero.querySelector<HTMLElement>('[data-caption-name]');
    const captionTag = hero.querySelector<HTMLElement>('[data-caption-tag]');
    const pad = (n: number) => String(n).padStart(2, '0');
    const switchDuration = 620;
    const switchEasing = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
    let index = Math.max(0, Number(hero.dataset.startIndex || 0));
    const setColors = (colors: FlavourColors) => {
      for (const key of ['primary', 'deep', 'soft'] as const) {
        hero.style.setProperty(`--flavour-${key}`, colors[key]);
        document.documentElement.style.setProperty(`--active-flavour-${key}`, colors[key]);
      }
    };
    let currentColors = toHslPalette(flavours[index].colors);
    let colorFrame = 0;
    setColors(flavours[index].colors);
    let timer: number | undefined;
    let switchingTimer: number | undefined;
    let inView = true;
    let hoverPaused = false;
    let focusPaused = false;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = motion.matches;

    const transitionColors = (target: FlavourColors) => {
      window.cancelAnimationFrame(colorFrame);
      const destination = toHslPalette(target);
      if (reduceMotion) {
        currentColors = destination;
        setColors(target);
        return;
      }
      const origin = currentColors;
      const started = performance.now();
      const animate = (now: number) => {
        const progress = Math.min(1, (now - started) / 820);
        const eased = progress * progress * (3 - 2 * progress);
        currentColors = mixHslPalette(origin, destination, eased);
        setColors(progress < 1 ? formatHslPalette(currentColors) : target);
        if (progress < 1) colorFrame = window.requestAnimationFrame(animate);
        else currentColors = destination;
      };
      colorFrame = window.requestAnimationFrame(animate);
    };

    const stop = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };

    const apply = (i: number) => {
      const f = flavours[i];
      if (!f || i === index) return;
      const previousIndex = index;
      const forwardDistance = (i - previousIndex + flavours.length) % flavours.length;
      const direction = forwardDistance <= flavours.length / 2 ? 1 : -1;
      hero.style.setProperty('--hero-enter-x', `${direction * 1.25}rem`);
      hero.style.setProperty('--hero-enter-rotate', `${direction * -2}deg`);
      hero.style.setProperty('--hero-leave-x', `${direction * -0.9}rem`);
      hero.style.setProperty('--hero-leave-rotate', `${direction * 1.5}deg`);
      index = i;
      layers.forEach((layer, li) => {
        const active = li === i;
        layer.classList.toggle('is-active', active);
        layer.classList.toggle('is-leaving', !active && li === previousIndex);
        layer.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      railLinks.forEach((link, li) => {
        link.classList.toggle('is-active', li === i);
        link.setAttribute('aria-pressed', String(li === i));
      });
      transitionColors(f.colors);
      if (nameEl) nameEl.textContent = f.name;
      if (tagEl) tagEl.textContent = f.mood;
      if (captionNum) captionNum.textContent = `Nº ${pad(f.order)}`;
      if (captionName) captionName.textContent = f.name;
      if (captionTag) captionTag.textContent = f.mood;
      window.clearTimeout(switchingTimer);
      hero.classList.remove('is-switching');
      if (!reduceMotion) {
        hero.classList.add('is-switching');
        void hero.offsetWidth;
        switchingTimer = window.setTimeout(() => hero.classList.remove('is-switching'), switchDuration);
        for (const label of [featuringEl, captionEl]) {
          if (!label) continue;
          label.getAnimations().forEach((animation) => animation.cancel());
          label.animate(
            [
              { opacity: 0, transform: `translate3d(${direction * 0.5}rem, 0, 0)`, filter: 'blur(3px)' },
              { opacity: 1, transform: 'translate3d(0, 0, 0)', filter: 'blur(0)' },
            ],
            { duration: switchDuration, easing: switchEasing }
          );
        }
      }
      const upcoming = layers[(i + 1) % layers.length]?.querySelector<HTMLImageElement>('.stage__float img');
      if (upcoming) upcoming.loading = 'eager';
    };

    const schedule = () => {
      stop();
      if (reduceMotion || !inView || document.hidden || hoverPaused || focusPaused || flavours.length < 2) return;
      timer = window.setTimeout(() => void select((index + 1) % flavours.length, false), 4600);
    };

    const select = (i: number, manual: boolean) => {
      if (i === index || !layers[i]) return;
      stop();
      const image = layers[i].querySelector<HTMLImageElement>('.stage__float img');
      if (!manual && (reduceMotion || !inView || document.hidden || hoverPaused || focusPaused)) return;
      if (image) image.loading = 'eager';
      apply(i);
      schedule();
    };

    railLinks.forEach((link, li) => link.addEventListener('click', () => void select(li, true)));

    let touchStart: { x: number; y: number } | undefined;
    stage?.addEventListener('touchstart', (event) => {
      const touch = event.changedTouches[0];
      if (touch) touchStart = { x: touch.clientX, y: touch.clientY };
    }, { passive: true });
    stage?.addEventListener('touchend', (event) => {
      const touch = event.changedTouches[0];
      if (!touch || !touchStart) return;
      const dx = touch.clientX - touchStart.x;
      const dy = touch.clientY - touchStart.y;
      touchStart = undefined;
      if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.35) {
        void select((index + (dx < 0 ? 1 : flavours.length - 1)) % flavours.length, true);
      }
    }, { passive: true });

    hero.addEventListener('mouseenter', () => {
      hoverPaused = true;
      stop();
    });
    hero.addEventListener('mouseleave', () => {
      hoverPaused = false;
      schedule();
    });
    hero.addEventListener('focusin', () => {
      focusPaused = true;
      stop();
    });
    hero.addEventListener('focusout', () => window.setTimeout(() => {
      focusPaused = hero.contains(document.activeElement);
      schedule();
    }, 0));
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', (event) => {
      reduceMotion = event.matches;
      if (reduceMotion) transitionColors(flavours[index].colors);
      schedule();
    });
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? false;
        schedule();
      }, { threshold: 0.25 });
      observer.observe(hero);
    }
    railLinks.forEach((link, li) => link.setAttribute('aria-pressed', String(li === index)));
    const nextImage = layers[(index + 1) % layers.length]?.querySelector<HTMLImageElement>('.stage__float img');
    if (nextImage) nextImage.loading = 'eager';
    schedule();
  }
</script>
