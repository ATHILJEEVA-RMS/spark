---
/* ============================================================
   HERO — premium storytelling opening.
   Automatically cycles through all 8 flavour worlds: the
   bottle, background gradient, ambient glow, blobs, accent
   colour and the "Now Featuring" badge all transform together
   while the headline + CTAs stay fixed. Crossfade + gentle
   scale + soft blur, 6–8s per flavour, pauses on hover.
   ============================================================ */
import { getCollection } from 'astro:content';
import { hero } from '../../data/site';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import CanStage from '../CanStage.astro';

const flavours = (await getCollection('flavours')).sort((a, b) => a.data.order - b.data.order);
const featured = flavours.find((f) => f.data.featured) ?? flavours[0];
const initial = featured.data.colors;
const [l1, l2, l3] = hero.title;
const pad = (n: number) => String(n).padStart(2, '0');

/* Flavour colour data serialised for the client — drives the
   smooth colour-world transitions on the whole hero. */
const flavourData = flavours.map((f) => ({
  id: f.id,
  name: f.data.name,
  mood: f.data.mood,
  order: f.data.order,
  colors: f.data.colors,
}));
---

<header
  class="hero"
  data-hero
  data-start-index={flavours.findIndex((f) => f.id === featured.id)}
  style={`--flavour-primary: ${initial.primary}; --flavour-deep: ${initial.deep}; --flavour-soft: ${initial.soft};`}
  data-flavours={JSON.stringify(flavourData)}
>
  {/* soft flavour atmosphere over the cream canvas */}
  <span class="hero__atmosphere" aria-hidden="true"></span>
  <span class="hero__blob hero__blob--1" aria-hidden="true"></span>
  <span class="hero__blob hero__blob--2" aria-hidden="true"></span>

  <Container>
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title" data-reveal="up" style="--reveal-delay: 80ms">
          <span class="hero__title-line">{l1}</span>
          <span class="hero__title-line">{l2}</span>
          <span class="hero__title-line hero__title-line--accent"><em>{l3}</em></span>
        </h1>

        {/* Dynamic flavour badge — the only copy that changes */}
        <div class="hero__featuring" data-reveal="up" style="--reveal-delay: 160ms" data-featuring>
          <span class="hero__featuring-label">Now Featuring</span>
          <span class="hero__featuring-name" data-featuring-name>{featured.data.name}</span>
          <span class="hero__featuring-tag" data-featuring-tag>{featured.data.mood}</span>
        </div>

        <p class="hero__lede" data-reveal="up" style="--reveal-delay: 220ms">
          {hero.lede}
        </p>

        <div class="hero__actions" data-reveal="up" style="--reveal-delay: 320ms">
          <Button href={hero.primaryCta.href} variant="accent" size="lg">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="clay" size="lg">{hero.secondaryCta.label}</Button>
        </div>
      </div>

      <div class="hero__stage" data-stage>
        {
          flavours.map((f, i) => (
            <div
              class:list={['hero__stage-layer', { 'is-active': f.id === featured.id }]}
              data-layer={i}
              style={`--flavour-primary: ${f.data.colors.primary}; --flavour-deep: ${f.data.colors.deep}; --flavour-soft: ${f.data.colors.soft};`}
              aria-hidden={f.id !== featured.id ? 'true' : 'false'}
            >
              <CanStage flavour={f} variant="hero" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))
        }
        <span class="hero__caption" data-caption>
          <span class="hero__caption-num" data-caption-num>Nº {pad(featured.data.order)}</span>
          <span class="hero__caption-name" data-caption-name>{featured.data.name}</span>
          <span class="hero__caption-line" aria-hidden="true"></span>
          <span class="hero__caption-tag" data-caption-tag>{featured.data.mood}</span>
        </span>
      </div>
    </div>
  </Container>

  {/* flavour index rail — desktop editorial device */}
  <nav class="hero__rail" aria-label="Flavour index" data-rail>
    <ol role="list">
      {
        flavours.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['hero__rail-link', { 'is-active': f.id === featured.id }]}
              data-rail-link={i}
              style={`--flavour-primary: ${f.data.colors.primary};`}
            >
              <span class="hero__rail-num">{pad(f.data.order)}</span>
              <span class="hero__rail-name">{f.data.name}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="hero__meta">
    <span class="hero__scroll" data-reveal="fade" style="--reveal-delay: 420ms">
      <span class="hero__scroll-dot" aria-hidden="true"></span>
      Scroll
    </span>
    <span class="hero__meta-rule" aria-hidden="true"></span>
    <span data-reveal="fade" style="--reveal-delay: 460ms">{hero.meta}</span>
  </div>
</header>

<style>
  /* Register flavour colour vars as smooth-transitioning
     custom properties so the whole hero colour-world morphs
     when JS swaps them. */
  @property --flavour-primary { syntax: '<color>'; inherits: true; initial-value: #f47b00; }
  @property --flavour-deep    { syntax: '<color>'; inherits: true; initial-value: #cf4b00; }
  @property --flavour-soft    { syntax: '<color>'; inherits: true; initial-value: #fde4cb; }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
    overflow: clip;
    transition:
      --flavour-primary var(--duration-slow) var(--ease-out-expo),
      --flavour-deep var(--duration-slow) var(--ease-out-expo),
      --flavour-soft var(--duration-slow) var(--ease-out-expo);
  }

  /* ---------- Atmosphere ---------- */
  .hero__atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 60% at 72% 30%,
        color-mix(in oklab, var(--flavour-primary) 30%, transparent) 0%,
        color-mix(in oklab, var(--flavour-soft) 65%, transparent) 48%,
        transparent 76%
      ),
      linear-gradient(180deg, var(--flavour-soft) 0%, var(--flavour-soft) 45%, var(--cream-50) 100%);
    opacity: 0.95;
    transition: background var(--duration-slow) var(--ease-out-expo);
  }

  /* floating clay blobs — the sanctioned decorative clay */
  .hero__blob {
    position: absolute;
    border-radius: 46% 54% 58% 42% / 52% 46% 54% 48%;
    background: linear-gradient(145deg, var(--cream-50), var(--cream-200));
    box-shadow: var(--shadow-clay);
    animation: hero-blob 9s ease-in-out infinite alternate;
    transition: background var(--duration-slow) var(--ease-out-expo);
  }

  .hero__blob--1 {
    width: clamp(5rem, 9vw, 9rem);
    aspect-ratio: 1;
    top: 16%;
    left: -2.5rem;
  }

  .hero__blob--2 {
    width: clamp(3.5rem, 6vw, 6rem);
    aspect-ratio: 1;
    bottom: 20%;
    left: 42%;
    animation-delay: -4s;
  }

  .hero :global(.container) {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-l);
    align-items: center;
    flex: 1;
  }

  /* ---------- Copy ---------- */
  .hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .hero__title {
    font-size: var(--text-hero);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--accent em {
    text-transform: none;
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--flavour-primary) 80%, white) 0%,
      var(--flavour-primary) 45%,
      var(--flavour-deep) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background var(--duration-slow) var(--ease-out-expo);
  }

  /* ---------- "Now Featuring" dynamic badge ---------- */
  .hero__featuring {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-pill);
    background: linear-gradient(145deg, var(--cream-50), var(--cream-200));
    box-shadow: var(--shadow-clay-sm);
    max-width: max-content;
  }

  .hero__featuring-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__featuring-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--flavour-primary);
    transition: color var(--duration-med) var(--ease-out-expo);
  }

  .hero__featuring-tag {
    font-size: var(--text-xs);
    color: var(--ink-700);
    letter-spacing: 0.02em;
  }

  .hero__featuring-tag::before {
    content: '— ';
    color: var(--ink-300);
  }

  .hero__lede {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    max-width: 38ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }

  /* ---------- Stage — stacked flavour layers ---------- */
  .hero__stage {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    margin-inline-start: calc(var(--space-3xl) * -1);
    min-height: clamp(20rem, 38vw, 32rem);
  }

  .hero__stage-layer {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(0.95) rotate(-2deg);
    filter: blur(8px);
    pointer-events: none;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo),
      transform var(--duration-slow) var(--ease-out-expo),
      filter var(--duration-slow) var(--ease-out-expo);
  }

  .hero__stage-layer.is-active {
    opacity: 1;
    transform: scale(1) rotate(0deg);
    filter: blur(0);
    pointer-events: auto;
  }

  .hero__caption {
    position: absolute;
    bottom: 6%;
    right: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    z-index: 3;
  }

  .hero__caption-num {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    color: var(--flavour-primary);
    transition: color var(--duration-med) var(--ease-out-expo);
  }

  .hero__caption-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
  }

  .hero__caption-line {
    width: 2.25rem;
    height: 1px;
    background: var(--ink-300);
    align-self: center;
  }

  .hero__caption-tag {
    color: var(--color-text-muted);
  }

  /* ---------- Flavour index rail ---------- */
  .hero__rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    z-index: 3;
  }

  .hero__rail ol {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .hero__rail-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--ink-300);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color var(--duration-fast) ease;
  }

  .hero__rail-num {
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero__rail-name {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width var(--duration-med) var(--ease-out-expo),
      opacity var(--duration-fast) ease;
  }

  .hero__rail-link:hover,
  .hero__rail-link.is-active {
    color: var(--flavour-primary);
    }

  .hero__rail-link:hover .hero__rail-name,
  .hero__rail-link.is-active .hero__rail-name {
    max-width: 8rem;
    opacity: 1;
  }

  .hero__rail-link.is-active .hero__rail-num {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* ---------- Meta strip ---------- */
  .hero__meta {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin: var(--space-s) auto 0;
    padding-inline: var(--gutter);
    width: 100%;
    max-width: var(--container);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .hero__scroll-dot {
    width: 1.35rem;
    height: 2.2rem;
    border: 1.5px solid var(--ink-300);
    border-radius: var(--radius-pill);
    position: relative;
  }

  .hero__scroll-dot::after {
    content: '';
    position: absolute;
    top: 0.35rem;
    left: 50%;
    translate: -50% 0;
    width: 3px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--flavour-primary);
    animation: hero-scroll 2s var(--ease-out-expo) infinite;
    transition: background var(--duration-med) var(--ease-out-expo);
  }

  .hero__meta-rule {
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }

  /* ---------- Motion ---------- */
  @keyframes hero-blob {
    from { transform: translateY(0) rotate(0deg); }
    to   { transform: translateY(-22px) rotate(8deg); }
  }

  @keyframes hero-scroll {
    0%   { transform: translateY(0); opacity: 1; }
    70%  { transform: translateY(0.8rem); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 80rem) {
    .hero__rail { display: none; }
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .hero__copy,
    .hero__stage {
      grid-column: 1;
      justify-items: center;
      text-align: center;
    }
    .hero__stage {
      order: -1;
      margin-inline-start: 0;
      min-height: clamp(16rem, 42vh, 24rem);
    }
    .hero__lede { margin-inline: auto; }
    .hero__caption {
      right: var(--space-s);
    }
  }

  @media (max-width: 30rem) {
    .hero { padding-top: var(--space-2xl); }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
    .hero__featuring {
      padding: 0.5em 1em;
    }
    .hero__meta {
      gap: var(--space-2xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage-layer {
      transition: opacity var(--duration-fast) ease;
      transform: none;
      filter: none;
    }
    .hero,
    .hero__atmosphere,
    .hero__blob,
    .hero__title-line--accent em,
    .hero__badge-dot,
    .hero__featuring-name,
    .hero__caption-num,
    .hero__scroll-dot::after {
      transition: none;
    }
  }
</style>

<script>
  /* Auto-cycle the hero through every flavour world.
     - 7s display per flavour, ~1s crossfade
     - pauses on hover/focus
     - rail links jump to a flavour
     - respects prefers-reduced-motion (static featured flavour) */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const flavours = JSON.parse(hero.dataset.flavours || '[]');
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-layer]'));
    const railLinks = Array.from(hero.querySelectorAll<HTMLElement>('[data-rail-link]'));
    const nameEl = hero.querySelector<HTMLElement>('[data-featuring-name]');
    const tagEl = hero.querySelector<HTMLElement>('[data-featuring-tag]');
    const captionNum = hero.querySelector<HTMLElement>('[data-caption-num]');
    const captionName = hero.querySelector<HTMLElement>('[data-caption-name]');
    const captionTag = hero.querySelector<HTMLElement>('[data-caption-tag]');
    const pad = (n: number) => String(n).padStart(2, '0');

    let index = Math.max(0, Number(hero.dataset.startIndex || 0));
    let timer: number | undefined;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const apply = (i: number) => {
      const f = flavours[i];
      if (!f) return;
      index = i;

      layers.forEach((layer, li) => {
        const active = li === i;
        layer.classList.toggle('is-active', active);
        layer.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      railLinks.forEach((link, li) => {
        link.classList.toggle('is-active', li === i);
      });

      /* morph the whole hero's colour world */
      hero.style.setProperty('--flavour-primary', f.colors.primary);
      hero.style.setProperty('--flavour-deep', f.colors.deep);
      hero.style.setProperty('--flavour-soft', f.colors.soft);

      if (nameEl) nameEl.textContent = f.name;
      if (tagEl) tagEl.textContent = f.mood;
      if (captionNum) captionNum.textContent = `Nº ${pad(f.order)}`;
      if (captionName) captionName.textContent = f.name;
      if (captionTag) captionTag.textContent = f.mood;
    };

    const next = () => apply((index + 1) % flavours.length);

    const start = () => {
      if (reduceMotion || flavours.length <= 1) return;
      window.clearInterval(timer);
      timer = window.setInterval(next, 7000);
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    /* pause on hover/focus-within */
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);

    /* rail links jump to a flavour and restart the timer */
    railLinks.forEach((link, li) => {
      link.addEventListener('click', () => {
        apply(li);
        start();
      });
    });

    /* pause when tab is hidden */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    apply(index);

    /* start after first paint so the stage is visible and the
       first crossfade is observable */
    requestAnimationFrame(() => requestAnimationFrame(start));
  }
</script>