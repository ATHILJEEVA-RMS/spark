---
/* ============================================================
   CONTACT — Enquiry form + enquiry cards.
   Enquiries submit to Web3Forms.
   ============================================================ */
import { contact, cta } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';

type IconName = 'spark' | 'globe' | 'basket' | 'pen' | 'mail';

const icons = {
  spark: '<path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4.2 5.7 4.2 9S14.8 18.4 12 21c-2.8-2.6-4.2-5.7-4.2-9S9.2 5.6 12 3z"/>',
  basket: '<path d="M4 9h16l-1.5 11h-13L4 9zM8 9l4-6 4 6"/>',
  pen: '<path d="M4 20l1-4L16 5l3 3L8 19l-4 1zM14 7l3 3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
};

const subjects = [
  'General Enquiry',
  'Business Partnership',
  'Distributor Enquiry',
  'Retail Opportunity',
  'Media & Collaboration',
  'Feedback',
  'Other',
];
---

<BaseLayout title="Contact" description={contact.copy}>
  <Section spacing="default">
    <div class="contact-hero">
      <Eyebrow>{contact.eyebrow}</Eyebrow>
      <h1 class="contact-hero__title" data-reveal="up">
        Let's build something <em>refreshing</em><br />together.
      </h1>
      <p class="contact-hero__copy" data-reveal="up" style="--reveal-delay: 140ms">
        {contact.copy}
      </p>
    </div>

    <!-- ─── Contact Form ─── -->
    <div class="contact-form-wrap" data-reveal="up" style="--reveal-delay: 200ms">
      <form class="contact-form clay" id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
        <input type="hidden" name="access_key" value="7adf6c4b-5692-4673-9f31-6bdf0d2d1370" />
        <input type="hidden" name="from_name" value="SPARK Website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-name">Full Name <span aria-hidden="true">*</span></label>
            <input class="contact-form__input" type="text" id="cf-name" name="name" required placeholder="Your name" autocomplete="name" aria-describedby="cf-name-error" />
            <span class="contact-form__error" id="cf-name-error" data-error="name"></span>
          </div>
          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-email">Email Address <span aria-hidden="true">*</span></label>
            <input class="contact-form__input" type="email" id="cf-email" name="email" required placeholder="you@example.com" autocomplete="email" aria-describedby="cf-email-error" />
            <span class="contact-form__error" id="cf-email-error" data-error="email"></span>
          </div>
        </div>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-phone">Phone Number <span aria-hidden="true">*</span></label>
            <input class="contact-form__input" type="tel" id="cf-phone" name="phone" required placeholder="+91 98765 43210" autocomplete="tel" aria-describedby="cf-phone-error" maxlength="20" />
            <span class="contact-form__error" id="cf-phone-error" data-error="phone"></span>
          </div>
          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-subject">Subject <span aria-hidden="true">*</span></label>
            <select class="contact-form__input contact-form__select" id="cf-subject" name="subject" required aria-describedby="cf-subject-error">
              <option value="" disabled selected>Select a subject</option>
              {subjects.map((s) => <option value={s}>{s}</option>)}
            </select>
            <span class="contact-form__error" id="cf-subject-error" data-error="subject"></span>
          </div>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="cf-message">Message <span aria-hidden="true">*</span></label>
          <textarea class="contact-form__input contact-form__textarea" id="cf-message" name="message" required rows="5" placeholder="Tell us what you have in mind..." aria-describedby="cf-message-error"></textarea>
          <span class="contact-form__error" id="cf-message-error" data-error="message"></span>
        </div>

        <div class="contact-form__actions">
          <button type="submit" class="contact-form__submit">
            Send Message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </div>

        <div class="contact-form__status contact-form__status--success" id="contact-success" role="status" hidden>
          <span class="contact-form__status-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </span>
          <span class="contact-form__status-body">
            <strong>Message sent!</strong>
            <span>We&rsquo;ll get back to you soon.</span>
          </span>
        </div>

        <div class="contact-form__status contact-form__status--failure" id="contact-failure" role="alert" hidden>
          <span class="contact-form__status-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <span class="contact-form__status-body">
            <strong>We couldn&rsquo;t send your message.</strong>
            <span>Please try again or <a href={`mailto:${contact.email}`}>email us directly</a>.</span>
          </span>
        </div>
      </form>
    </div>

    <!-- ─── Enquiry Cards ─── -->
    <div class="contact-grid">
      {
        contact.enquiries.map((q, i) => (
          <article
            id={q.id}
            class="contact-card clay"
            data-reveal="up"
            style={`--reveal-delay: ${(i % 2) * 110}ms; scroll-margin-top: 8rem;`}
          >
            <span class="contact-card__icon" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[q.icon as IconName] ?? icons.spark} />
            </span>
            <h2 class="contact-card__title">{q.title}</h2>
            <p class="contact-card__body">{q.body}</p>
            <a class="contact-card__link" href={`mailto:${contact.email}?subject=${encodeURIComponent(q.title)}`}>
              {contact.email}
            </a>
          </article>
        ))
      }
    </div>

    <div class="contact-cta">
      <Button href={cta.href} variant="ink" size="lg">{cta.label}</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .contact-hero {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    max-width: 52rem;
    margin-bottom: var(--space-xl);
    padding-top: calc(var(--space-2xl) + 1rem);
  }

  .contact-hero__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .contact-hero__title em {
    font-style: italic;
    color: var(--orange);
  }

  .contact-hero__copy {
    color: var(--color-text-muted);
    font-size: var(--text-md);
    max-width: 52ch;
  }

  /* ─── Form ─── */
  .contact-form-wrap {
    max-width: 52rem;
    margin-bottom: var(--space-2xl);
  }

  .contact-form {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  .contact-form__field {
    display: grid;
    gap: var(--space-3xs);
  }

  .contact-form__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-700);
  }

  .contact-form__label span {
    color: var(--orange);
  }

  .contact-form__input {
    width: 100%;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--ink-300);
    background: var(--cream-50);
    color: var(--ink-900);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    outline: none;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .contact-form__input::placeholder {
    color: var(--ink-300);
  }

  .contact-form__input:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--orange) 20%, transparent);
  }

  .contact-form__input.is-invalid {
    border-color: var(--cola);
  }

  .contact-form__select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%233e352b' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right var(--space-s) center;
    padding-right: var(--space-xl);
    cursor: pointer;
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact-form__error {
    font-size: var(--text-xs);
    color: var(--cola);
    min-height: 1em;
  }

  .contact-form__actions {
    display: flex;
    justify-content: flex-end;
  }

  .contact-form__submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-l);
    border: none;
    border-radius: var(--radius-pill);
    background: linear-gradient(145deg, var(--orange), var(--orange-deep));
    color: var(--cream-50);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-clay-sm);
    transition:
      translate var(--duration-fast) var(--ease-out-expo),
      box-shadow var(--duration-fast) var(--ease-out-expo);
  }

  .contact-form__submit:hover {
    translate: 0 -3px;
    box-shadow: var(--shadow-clay);
  }

  .contact-form__submit:active {
    translate: 0 0;
  }

  .contact-form__status {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.45;
    animation: contact-status-in 0.45s var(--ease-out-expo) both;
  }

  .contact-form__status[hidden] { display: none; }

  .contact-form__status--success {
    background: var(--green-apple-soft);
    border-color: color-mix(in oklab, var(--green-apple) 45%, transparent);
    color: var(--green-apple-deep);
  }

  .contact-form__status--failure {
    background: var(--cola-soft);
    border-color: color-mix(in oklab, var(--cola) 40%, transparent);
    color: var(--cola-deep);
  }

  .contact-form__status-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--cream-50) 75%, transparent);
    border: 1px solid color-mix(in oklab, currentColor 35%, transparent);
  }

  .contact-form__status-body {
    display: grid;
    gap: 0.1em;
  }

  .contact-form__status-body strong {
    font-weight: 700;
  }

  .contact-form__status-body a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @keyframes contact-status-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ─── Enquiry Grid ─── */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  .contact-card {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: var(--space-l);
    transition:
      box-shadow var(--duration-med) var(--ease-out-expo),
      translate var(--duration-med) var(--ease-out-expo);
  }

  .contact-card:hover {
    box-shadow: var(--shadow-clay-hover);
    translate: 0 -6px;
  }

  .contact-card__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(145deg, var(--cream-50), var(--cream-300));
    box-shadow: var(--shadow-clay-sm);
    color: var(--ink-700);
  }

  .contact-card__title {
    font-size: var(--text-lg);
  }

  .contact-card__body {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 36ch;
  }

  .contact-card__link {
    justify-self: start;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-900);
    border-bottom: 1.5px solid var(--orange);
    padding-bottom: 0.1em;
    transition: opacity var(--duration-fast) ease;
  }

  .contact-card__link:hover {
    opacity: 0.65;
  }

  .contact-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  /* ─── Responsive ─── */
  @media (max-width: 48rem) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-form__row { grid-template-columns: 1fr; }
  }

  @media (max-width: 30rem) {
    .contact-hero__title {
      font-size: var(--text-xl);
    }
    .contact-card {
      padding: var(--space-m);
    }
    .contact-card__icon {
      width: 3rem;
      height: 3rem;
    }
    .contact-form {
      padding: var(--space-m);
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('contact-success');
  const failureMsg = document.getElementById('contact-failure');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const name = (data.get('name') as string).trim();
    const email = (data.get('email') as string).trim();
    const phone = (data.get('phone') as string).trim();
    const subject = String(data.get('subject') ?? '').trim();
    const message = (data.get('message') as string).trim();

    let valid = true;
    if (successMsg) successMsg.hidden = true;
    if (failureMsg) failureMsg.hidden = true;
    const fields = [
      { key: 'name', val: name, msg: 'Please enter your full name' },
      { key: 'email', val: email, msg: 'Please enter a valid email' },
      { key: 'phone', val: phone, msg: 'Please enter a valid phone number' },
      { key: 'subject', val: subject, msg: 'Please select a subject' },
      { key: 'message', val: message, msg: 'Tell us something!' },
    ];

    fields.forEach(({ key, val, msg }) => {
      const errEl = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
      const inputEl = form.querySelector<HTMLElement>(`[name="${key}"]`);
      if (!val) {
        if (errEl) errEl.textContent = msg;
        inputEl?.classList.add('is-invalid');
        inputEl?.setAttribute('aria-invalid', 'true');
        valid = false;
      } else {
        if (errEl) errEl.textContent = '';
        inputEl?.classList.remove('is-invalid');
        inputEl?.removeAttribute('aria-invalid');
      }
    });

    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      const errEl = form.querySelector<HTMLElement>('[data-error="email"]');
      const inputEl = form.querySelector<HTMLElement>('[name="email"]');
      if (errEl) errEl.textContent = 'Please enter a valid email';
      inputEl?.classList.add('is-invalid');
      inputEl?.setAttribute('aria-invalid', 'true');
      valid = false;
    }

    if (phone) {
      let digits = phone.replace(/\D/g, '');
      if (digits.length === 12 && digits.startsWith('91')) digits = digits.slice(2);
      else if (digits.length === 11 && digits.startsWith('0')) digits = digits.slice(1);
      const looksValid = /^\+?[\d\s\-()]+$/.test(phone) && digits.length === 10;
      const errEl = form.querySelector<HTMLElement>('[data-error="phone"]');
      const inputEl = form.querySelector<HTMLElement>('[name="phone"]');
      if (!looksValid) {
        if (errEl) errEl.textContent = 'Please enter a valid phone number';
        inputEl?.classList.add('is-invalid');
        inputEl?.setAttribute('aria-invalid', 'true');
        valid = false;
      } else {
        if (errEl) errEl.textContent = '';
        inputEl?.classList.remove('is-invalid');
        inputEl?.removeAttribute('aria-invalid');
      }
    }

    if (!valid) {
      form.querySelector<HTMLElement>('.is-invalid')?.focus();
      return;
    }

    // Greeting leads the email body; Web3Forms renders each field
    // (Name/Email/Phone/Subject/Message) as its own section in the email.
    data.set('subject', `[SPARK Contact from website] ${subject}`);
    data.set('message', `${message}`);

    // 1. Send email via Web3Forms API
    const submitBtn = form.querySelector<HTMLButtonElement>('.contact-form__submit');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const result = await response.json();

      if (response.ok && result.success) {
        if (successMsg) successMsg.hidden = false;
        form.reset();
      } else {
        if (failureMsg) failureMsg.hidden = false;
      }
    } catch {
      if (failureMsg) failureMsg.hidden = false;
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `Send Message <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>`;
      }
    }

  });

  form?.querySelectorAll('.contact-form__input').forEach((input) => {
    input.addEventListener('input', () => {
      input.classList.remove('is-invalid');
      input.removeAttribute('aria-invalid');
      const key = input.getAttribute('name');
      const errEl = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
      if (errEl) errEl.textContent = '';
    });
  });
</script>
