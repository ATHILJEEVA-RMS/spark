---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import CollectionStrip from '../components/sections/CollectionStrip.astro';
import Future from '../components/sections/Future.astro';
import Craft from '../components/sections/Craft.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import HomeAtmosphere from '../components/HomeAtmosphere.astro';
---

<BaseLayout
  description="Explore SPARK sparkling drinks: eight distinct flavours, from bright citrus and tropical favourites to classic cola."
>
  <div class="home-scene" data-home-scene>
    <div class="hero-story">
      <span class="hero-story__atmosphere" aria-hidden="true"></span>
      <Hero />
      <Manifesto />
    </div>
    <CollectionStrip />
    <Future />
    <Craft />
    <CtaSection />
  </div>
  <HomeAtmosphere slot="atmosphere" />
</BaseLayout>

<style>
  .hero-story {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--cream-50);
  }
  .hero-story__atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 42% at 72% 16%, color-mix(in oklab, var(--active-flavour-primary) 18%, transparent) 0%, color-mix(in oklab, var(--active-flavour-soft) 72%, transparent) 48%, transparent 76%),
      linear-gradient(180deg, var(--active-flavour-soft) 0%, color-mix(in oklab, var(--active-flavour-soft) 78%, var(--cream-50)) 30%, var(--cream-50) 78%, var(--cream-50) 100%);
  }
</style>
