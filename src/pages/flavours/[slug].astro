---
/* ============================================================
   FLAVOUR DETAIL — immersive single-flavour experience.
   Deep-gradient hero with oversized name, staged can,
   tasting notes, prev/next nav.
   ============================================================ */
import type { CollectionEntry } from 'astro:content';
import { getFlavours } from '../../data/flavours';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import CanStage from '../../components/CanStage.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const flavours = await getFlavours();
  return flavours.map((flavour, i) => ({
    params: { slug: flavour.id },
    props: {
      flavour,
      prev: flavours[i - 1] ?? flavours[flavours.length - 1],
      next: flavours[i + 1] ?? flavours[0],
    },
  }));
}

interface Props {
  flavour: CollectionEntry<'flavours'>;
  prev: CollectionEntry<'flavours'>;
  next: CollectionEntry<'flavours'>;
}

const { flavour, prev, next } = Astro.props;
const { name, tagline, mood, description, colors, notes, status, volume } = flavour.data;
const num = String(flavour.data.order).padStart(2, '0');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `SPARK ${name}`,
  description,
  brand: { '@type': 'Brand', name: 'SPARK' },
  image: new URL(flavour.data.image.src.src, site.url).href,
};
---

<BaseLayout title={`${name} Sparkling Drink`} description={`${tagline} — ${description}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Immersive hero — full-bleed flavour world */}
  <header
    class="flavour-hero"
    style={`--flavour-primary: ${colors.primary}; --flavour-deep: ${colors.deep}; --flavour-soft: ${colors.soft};`}
  >
    {/* Background atmosphere */}
    <span class="flavour-hero__atmosphere" aria-hidden="true"></span>

    <Container>
      <div class="flavour-hero__grid">
        <div class="flavour-hero__copy">
          <p class="flavour-hero__eyebrow" data-reveal="fade">
            Nº {num} / {mood}
            {status !== 'current' && <span class="flavour-hero__badge">{status} edition</span>}
          </p>

          <h1 class="flavour-hero__name" data-reveal="up">
            <em>{name}</em>
          </h1>

          <p class="flavour-hero__tagline" data-reveal="up" style="--reveal-delay: 100ms">{tagline}</p>

          <p class="flavour-hero__description" data-reveal="up" style="--reveal-delay: 160ms">{description}</p>

          <div class="flavour-hero__notes" data-reveal="up" style="--reveal-delay: 220ms">
            <span class="flavour-hero__notes-label">Tasting notes</span>
            <div class="flavour-hero__note-list" role="list">
              {notes.map((note, i) => (
                <span class="flavour-hero__note" role="listitem">
                  <span class="flavour-hero__note-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {note}
                </span>
              ))}
            </div>
          </div>

          <div class="flavour-hero__volume" data-reveal="up" style="--reveal-delay: 260ms">
            <span class="flavour-hero__volume-value">{volume}</span>
            <span class="flavour-hero__volume-label">Bottle size</span>
          </div>

          <div class="flavour-hero__actions" data-reveal="up" style="--reveal-delay: 300ms">
            <Button href={`/spark/contact?flavour=${flavour.id}#availability`} variant="ink" size="lg">Ask Where to Find It</Button>
            <a href="/spark/flavours" class="flavour-hero__all">Browse all flavours <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="flavour-hero__stage" data-reveal="scale" style="--reveal-delay: 150ms">
          <CanStage {flavour} variant="hero" loading="eager" />
        </div>
      </div>
    </Container>

    {/* Ghost numeral */}
    <span class="flavour-hero__num" aria-hidden="true">{num}</span>
  </header>

  {/* Prev/Next navigation */}
  <nav class="flavour-nav" aria-label="Flavour navigation">
    <Container>
      <div class="flavour-nav__inner">
        <a
          href={`/spark/flavours/${prev.id}`}
          class="flavour-nav__link"
          style={`--flavour-primary: ${prev.data.colors.primary}; --flavour-soft: ${prev.data.colors.soft};`}
        >
          <span class="flavour-nav__label">← Previous</span>
          <span class="flavour-nav__name">{prev.data.name}</span>
          <span class="flavour-nav__mood">{prev.data.mood}</span>
        </a>

        <a href="/spark/flavours" class="flavour-nav__all">
          <span class="flavour-nav__all-text">All Flavours</span>
        </a>

        <a
          href={`/spark/flavours/${next.id}`}
          class="flavour-nav__link flavour-nav__link--next"
          style={`--flavour-primary: ${next.data.colors.primary}; --flavour-soft: ${next.data.colors.soft};`}
        >
          <span class="flavour-nav__label">Next →</span>
          <span class="flavour-nav__name">{next.data.name}</span>
          <span class="flavour-nav__mood">{next.data.mood}</span>
        </a>
      </div>
    </Container>
  </nav>

  <CtaSection />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .flavour-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: clip;
    /* Full flavour world gradient */
    background:
      radial-gradient(
        60% 60% at 72% 30%,
        color-mix(in oklab, var(--flavour-primary) 30%, transparent) 0%,
        color-mix(in oklab, var(--flavour-soft) 65%, transparent) 48%,
        transparent 76%
      ),
      linear-gradient(
        180deg,
        var(--flavour-soft) 0%,
        color-mix(in oklab, var(--flavour-soft) 58%, var(--flavour-primary)) 45%,
        var(--cream-50) 100%
      );
  }

  .flavour-hero__atmosphere {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 20% 0%,
      color-mix(in oklab, var(--flavour-primary) 25%, white) 0%,
      transparent 55%
    );
    opacity: 0.5;
  }

  .flavour-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(var(--space-l), 6vw, var(--space-3xl));
    align-items: center;
    padding: var(--space-3xl) 0;
  }

  .flavour-hero__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .flavour-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .flavour-hero__actions :global(.btn) { min-height: 3.25rem; }

  .flavour-hero__all {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 3.25rem;
    padding-inline: 0.55rem;
    color: var(--ink-900);
    font-size: var(--text-sm);
    font-weight: 650;
    text-underline-offset: 0.3em;
    transition: color var(--duration-fast) ease, translate var(--duration-fast) var(--ease-out-expo);
  }

  .flavour-hero__all:hover { color: var(--flavour-deep); translate: 0 -2px; }

  .flavour-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-700);
    opacity: 0.8;
  }

  .flavour-hero__badge {
    padding: 0.35em 1em;
    border-radius: var(--radius-pill);
    background: var(--flavour-primary);
    color: var(--cream-50);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .flavour-hero__name {
    font-size: var(--text-hero);
    line-height: var(--leading-none);
    text-transform: uppercase;
    color: var(--ink-900);
  }

  .flavour-hero__name em {
    font-style: italic;
    font-weight: 400;
    color: color-mix(in oklab, var(--flavour-deep) 66%, var(--ink-900));
  }

  .flavour-hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--ink-700);
    max-width: 30ch;
  }

  .flavour-hero__description {
    font-size: var(--text-md);
    color: var(--ink-700);
    opacity: 0.85;
    max-width: 44ch;
    line-height: var(--leading-body);
  }

  .flavour-hero__notes {
    display: grid;
    gap: var(--space-2xs);
  }

  .flavour-hero__note-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .flavour-hero__notes-label {
    flex-basis: 100%;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-700);
  }

  .flavour-hero__note {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.55em 1.3em;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      145deg,
      rgb(253 251 245 / 0.85),
      color-mix(in oklab, var(--flavour-soft) 70%, white)
    );
    box-shadow: var(--shadow-clay-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-700);
  }

  .flavour-hero__note-index {
    color: var(--flavour-deep);
    font-size: 0.78em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0.72;
  }

  .flavour-hero__volume {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.45rem 0.75rem;
    border-left: 2px solid var(--flavour-primary);
    color: var(--ink-700);
  }

  .flavour-hero__volume-value {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
  }

  .flavour-hero__volume-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Ghost numeral */
  .flavour-hero__num {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: clamp(16rem, 30vw, 30rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--flavour-primary) 25%, transparent);
    opacity: 0.4;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* ---------- Nav ---------- */
  .flavour-nav {
    padding-block: var(--space-2xl);
    background: var(--cream-50);
    border-top: 1px solid var(--color-line);
  }

  .flavour-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-l);
    align-items: center;
  }

  .flavour-nav__link {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-l);
    border-radius: var(--radius-clay);
    background: linear-gradient(
      145deg,
      var(--cream-50),
      color-mix(in oklab, var(--flavour-soft, var(--cream-200)) 50%, white)
    );
    box-shadow: var(--shadow-clay-sm);
    transition:
      box-shadow var(--duration-med) var(--ease-out-expo),
      translate var(--duration-med) var(--ease-out-expo);
  }

  .flavour-nav__link:hover {
    box-shadow: var(--shadow-clay-hover);
    translate: 0 -4px;
  }

  .flavour-nav__link--next {
    text-align: right;
  }

  .flavour-nav__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .flavour-nav__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
  }

  .flavour-nav__mood {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .flavour-nav__all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--ink-900);
    color: var(--cream-50);
    white-space: nowrap;
    transition: translate var(--duration-fast) var(--ease-out-expo), background-color var(--duration-fast) ease;
  }

  .flavour-nav__all:hover {
    translate: 0 -3px;
    background: var(--flavour-primary, var(--orange));
  }

  .flavour-nav__all-text {
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: nowrap;
    border: 0;
  }

  .flavour-nav__all::after { content: none; }
  .flavour-nav__all-text::after { content: ' ↗'; margin-inline-start: 0.25em; }

  .flavour-nav__all-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .flavour-nav__all::after {
    content: '✦';
    font-size: var(--text-md);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 56rem) {
    .flavour-hero {
      min-height: auto;
      padding-top: 4.75rem;
    }

    .flavour-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-s);
      padding: var(--space-l) 0 var(--space-2xl);
    }

    .flavour-hero__copy {
      justify-items: center;
      text-align: center;
      order: 2;
    }

    .flavour-hero__stage {
      order: 1;
      width: min(76vw, 16rem);
      justify-self: center;
    }

    .flavour-hero__description {
      margin-inline: auto;
    }

    .flavour-hero__name {
      font-size: var(--text-3xl);
    }

    .flavour-hero__copy { gap: var(--space-xs); }
    .flavour-hero__actions { justify-content: center; }

    .flavour-hero__num {
      font-size: 12rem;
      opacity: 0.25;
    }
  }

  @media (max-width: 48rem) {
    .flavour-nav__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-s);
    }

    .flavour-nav__link--next {
      text-align: left;
    }

    .flavour-nav__all {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }

    .flavour-nav__link {
      padding: var(--space-s);
    }

    .flavour-nav__name { font-size: var(--text-lg); }
    .flavour-nav__mood { font-size: var(--text-xs); }
  }

  @media (max-width: 30rem) {
    .flavour-hero { padding-top: 4.5rem; }

    .flavour-hero__grid {
      gap: var(--space-2xs);
      padding-top: var(--space-s);
      padding-bottom: var(--space-xl);
    }

    .flavour-hero__stage { width: min(68vw, 15rem); }

    .flavour-hero__copy { gap: 0.625rem; }

    .flavour-hero__name { font-size: clamp(3rem, 15vw, 4rem); }

    .flavour-hero__tagline {
      font-size: var(--text-lg);
    }

    .flavour-hero__description { font-size: var(--text-sm); }

    .flavour-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
      width: min(100%, 22rem);
    }

    .flavour-hero__actions :global(.btn) {
      justify-content: center;
      min-height: 2.9rem;
    }

    .flavour-hero__all { min-height: 2.5rem; justify-content: center; }

    .flavour-hero__num {
      font-size: 8rem;
    }

    .flavour-nav { padding-block: var(--space-xl); }
    .flavour-nav__link { min-height: 7rem; }
    .flavour-nav__name { font-size: var(--text-md); }
    .flavour-nav__mood { display: none; }
    .flavour-nav__all { min-height: 2.75rem; }
  }

  @media (max-width: 22rem) {
    .flavour-hero__note { font-size: 0.72rem; padding: 0.42em 0.68em; }
    .flavour-nav__link { padding: var(--space-xs); }
    .flavour-nav__label { letter-spacing: 0.08em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flavour-hero__stage {
      animation: none;
    }
    .flavour-nav__link,
    .flavour-nav__all { transition: none; }
  }

  .flavour-nav__all-text {
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: nowrap;
    border: 0;
  }

  .flavour-nav__all::after { content: none; }
  .flavour-nav__all-text::after { content: ' ↗'; margin-inline-start: 0.25em; }
</style>
