---
/* ============================================================
   FLAVOUR DETAIL — immersive single-flavour experience.
   Deep-gradient hero with oversized name, staged can,
   tasting notes, prev/next nav.
   ============================================================ */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import CanStage from '../../components/CanStage.astro';
import CtaSection from '../../components/sections/CtaSection.astro';

export async function getStaticPaths() {
  const flavours = (await getCollection('flavours')).sort((a, b) => a.data.order - b.data.order);
  return flavours.map((flavour, i) => ({
    params: { slug: flavour.id },
    props: {
      flavour,
      prev: flavours[i - 1] ?? flavours[flavours.length - 1],
      next: flavours[i + 1] ?? flavours[0],
    },
  }));
}

interface Props {
  flavour: CollectionEntry<'flavours'>;
  prev: CollectionEntry<'flavours'>;
  next: CollectionEntry<'flavours'>;
}

const { flavour, prev, next } = Astro.props;
const { name, tagline, mood, description, colors, notes, status, volume } = flavour.data;
const num = String(flavour.data.order).padStart(2, '0');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `SPARK ${name}`,
  description,
  brand: { '@type': 'Brand', name: 'SPARK' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout title={name} description={`${tagline} — ${description}`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Immersive hero — full-bleed flavour world */}
  <header
    class="flavour-hero"
    style={`--flavour-primary: ${colors.primary}; --flavour-deep: ${colors.deep}; --flavour-soft: ${colors.soft};`}
  >
    {/* Background atmosphere */}
    <span class="flavour-hero__atmosphere" aria-hidden="true"></span>

    <Container>
      <div class="flavour-hero__grid">
        <div class="flavour-hero__copy">
          <p class="flavour-hero__eyebrow" data-reveal="fade">
            Nº {num} / {mood}
            {status !== 'current' && <span class="flavour-hero__badge">{status} edition</span>}
          </p>

          <h1 class="flavour-hero__name" data-reveal="up">
            <em>{name}</em>
          </h1>

          <p class="flavour-hero__tagline" data-reveal="up" style="--reveal-delay: 100ms">{tagline}</p>

          <p class="flavour-hero__description" data-reveal="up" style="--reveal-delay: 160ms">{description}</p>

          <div class="flavour-hero__notes" data-reveal="up" style="--reveal-delay: 220ms">
            {notes.map((note) => (
              <span class="flavour-hero__note">{note}</span>
            ))}
          </div>

          <div class="flavour-hero__volume" data-reveal="up" style="--reveal-delay: 260ms">
            {volume}
          </div>

          <div class="flavour-hero__actions" data-reveal="up" style="--reveal-delay: 300ms">
            <Button href="/flavours" variant="clay" size="lg">All Flavours</Button>
          </div>
        </div>

        <div class="flavour-hero__stage" data-reveal="scale" style="--reveal-delay: 150ms">
          <CanStage {flavour} variant="hero" loading="eager" />
        </div>
      </div>
    </Container>

    {/* Ghost numeral */}
    <span class="flavour-hero__num" aria-hidden="true">{num}</span>
  </header>

  {/* Prev/Next navigation */}
  <nav class="flavour-nav" aria-label="Flavour navigation">
    <Container>
      <div class="flavour-nav__inner">
        <a
          href={`/flavours/${prev.id}`}
          class="flavour-nav__link"
          style={`--flavour-primary: ${prev.data.colors.primary}; --flavour-soft: ${prev.data.colors.soft};`}
        >
          <span class="flavour-nav__label">← Previous</span>
          <span class="flavour-nav__name">{prev.data.name}</span>
          <span class="flavour-nav__mood">{prev.data.mood}</span>
        </a>

        <a href="/flavours" class="flavour-nav__all">
          <span class="flavour-nav__all-text">All Flavours</span>
        </a>

        <a
          href={`/flavours/${next.id}`}
          class="flavour-nav__link flavour-nav__link--next"
          style={`--flavour-primary: ${next.data.colors.primary}; --flavour-soft: ${next.data.colors.soft};`}
        >
          <span class="flavour-nav__label">Next →</span>
          <span class="flavour-nav__name">{next.data.name}</span>
          <span class="flavour-nav__mood">{next.data.mood}</span>
        </a>
      </div>
    </Container>
  </nav>

  <CtaSection />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .flavour-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: clip;
    /* Full flavour world gradient */
    background:
      radial-gradient(
        60% 60% at 72% 30%,
        color-mix(in oklab, var(--flavour-primary) 30%, transparent) 0%,
        color-mix(in oklab, var(--flavour-soft) 65%, transparent) 48%,
        transparent 76%
      ),
      linear-gradient(
        180deg,
        var(--flavour-soft) 0%,
        color-mix(in oklab, var(--flavour-soft) 58%, var(--flavour-primary)) 45%,
        var(--cream-50) 100%
      );
  }

  .flavour-hero__atmosphere {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 20% 0%,
      color-mix(in oklab, var(--flavour-primary) 25%, white) 0%,
      transparent 55%
    );
    opacity: 0.5;
  }

  .flavour-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-3xl) 0;
  }

  .flavour-hero__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .flavour-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-700);
    opacity: 0.8;
  }

  .flavour-hero__badge {
    padding: 0.35em 1em;
    border-radius: var(--radius-pill);
    background: var(--flavour-primary);
    color: var(--cream-50);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .flavour-hero__name {
    font-size: var(--text-hero);
    line-height: var(--leading-none);
    text-transform: uppercase;
    color: var(--ink-900);
  }

  .flavour-hero__name em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--flavour-primary) 80%, white) 0%,
      var(--flavour-primary) 45%,
      var(--flavour-deep) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .flavour-hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--ink-700);
    max-width: 30ch;
  }

  .flavour-hero__description {
    font-size: var(--text-md);
    color: var(--ink-700);
    opacity: 0.85;
    max-width: 44ch;
    line-height: var(--leading-body);
  }

  .flavour-hero__notes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .flavour-hero__note {
    padding: 0.55em 1.3em;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      145deg,
      rgb(253 251 245 / 0.85),
      color-mix(in oklab, var(--flavour-soft) 70%, white)
    );
    box-shadow: var(--shadow-clay-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-700);
  }

  .flavour-hero__volume {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--ink-500);
  }

  /* Ghost numeral */
  .flavour-hero__num {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: clamp(16rem, 30vw, 30rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--flavour-primary) 25%, transparent);
    opacity: 0.4;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* ---------- Nav ---------- */
  .flavour-nav {
    padding-block: var(--space-2xl);
    background: var(--cream-50);
    border-top: 1px solid var(--color-line);
  }

  .flavour-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-l);
    align-items: center;
  }

  .flavour-nav__link {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-l);
    border-radius: var(--radius-clay);
    background: linear-gradient(
      145deg,
      var(--cream-50),
      color-mix(in oklab, var(--flavour-soft, var(--cream-200)) 50%, white)
    );
    box-shadow: var(--shadow-clay-sm);
    transition:
      box-shadow var(--duration-med) var(--ease-out-expo),
      translate var(--duration-med) var(--ease-out-expo);
  }

  .flavour-nav__link:hover {
    box-shadow: var(--shadow-clay-hover);
    translate: 0 -4px;
  }

  .flavour-nav__link--next {
    text-align: right;
  }

  .flavour-nav__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .flavour-nav__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
  }

  .flavour-nav__mood {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .flavour-nav__all {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--cream-50);
    transition: translate var(--duration-fast) var(--ease-out-expo);
  }

  .flavour-nav__all:hover {
    translate: 0 -3px;
  }

  .flavour-nav__all-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .flavour-nav__all::after {
    content: '✦';
    font-size: var(--text-md);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 56rem) {
    .flavour-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
      padding: var(--space-2xl) 0;
    }

    .flavour-hero__copy {
      justify-items: center;
      text-align: center;
      order: 2;
    }

    .flavour-hero__stage {
      order: 1;
    }

    .flavour-hero__description {
      margin-inline: auto;
    }

    .flavour-hero__name {
      font-size: var(--text-3xl);
    }

    .flavour-hero__num {
      font-size: 12rem;
      opacity: 0.25;
    }
  }

  @media (max-width: 48rem) {
    .flavour-nav__inner {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .flavour-nav__link--next {
      text-align: left;
    }

    .flavour-nav__all {
      margin-inline: auto;
    }
  }

  @media (max-width: 30rem) {
    .flavour-hero__name {
      font-size: var(--text-2xl);
    }

    .flavour-hero__tagline {
      font-size: var(--text-lg);
    }

    .flavour-hero__num {
      font-size: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flavour-hero__stage {
      animation: none;
    }
  }
</style>
