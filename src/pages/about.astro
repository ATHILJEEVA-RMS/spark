---
/* ============================================================
   ABOUT — the brand story.
   We don't just make drinks. We create moments.
   ============================================================ */
import { about, journey } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import FlavourSpotlight from '../components/sections/FlavourSpotlight.astro';

const [a1, a2] = about.heading;
const [j1, j2] = journey.heading;
---

<BaseLayout title="About" description={about.body}>
  <Section spacing="default" width="narrow">
    <div class="about-hero">
      <Eyebrow>{about.eyebrow}</Eyebrow>
      <h1 class="about-hero__title" data-reveal="up">
        <span>{a1}</span>
        <span class="about-hero__line--accent"><em>{a2}</em></span>
      </h1>
      <p class="about-hero__body" data-reveal="up" style="--reveal-delay: 160ms">
        {about.body}
      </p>
    </div>
  </Section>

  <Section spacing="tight">
    <div class="about-mission">
      <div class="about-mission__aside">
        <Eyebrow class="about-mission__eyebrow">{about.mission.heading}</Eyebrow>
        <span class="about-mission__mark" aria-hidden="true">◈</span>
      </div>
      <p class="about-mission__body" data-reveal="up">
        {about.mission.body}
      </p>
    </div>
  </Section>

  <Section spacing="tight">
    <div class="about-journey">
      <div class="about-journey__header">
        <Eyebrow>{journey.eyebrow}</Eyebrow>
        <h2 class="about-journey__title" data-reveal="up">
          <span>{j1}</span>
          <span class="about-journey__line--accent"><em>{j2}</em></span>
        </h2>
        <p class="about-journey__body" data-reveal="up" style="--reveal-delay: 120ms">
          {journey.body}
        </p>
      </div>
      <div class="about-journey__milestones" data-reveal="up" style="--reveal-delay: 200ms">
        {journey.milestones.map((m) => (
          <div class="milestone">
            <span class="milestone__year">{m.year}</span>
            <span class="milestone__label">{m.label}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <FlavourSpotlight />

  <Section width="narrow">
    <div class="about-cta">
      <h2 class="about-cta__title" data-reveal="up">
        Taste the <em>moods.</em>
      </h2>
      <div data-reveal="up" style="--reveal-delay: 140ms">
        <Button href="/spark/flavours" variant="ink" size="lg">Explore Flavours</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-top: calc(var(--space-2xl) + 1rem);
  }

  .about-hero__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    max-width: 22ch;
  }

  .about-hero__title span {
    display: block;
  }

  .about-hero__line--accent em {
    font-style: italic;
    font-weight: 400;
    color: var(--orange);
  }

  .about-hero__body {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  .about-mission {
    display: grid;
    grid-template-columns: 0.6fr 2.2fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-mission__aside {
    position: sticky;
    top: 8rem;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .about-mission__mark {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--orange);
    font-style: italic;
  }

  .about-mission__body {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--ink-700);
    max-width: 42ch;
  }

  .about-cta {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .about-cta__title {
    font-size: var(--text-2xl);
  }

  .about-cta__title em {
    font-style: italic;
    color: var(--orange);
  }

  @media (max-width: 48rem) {
    .about-mission { grid-template-columns: 1fr; }
    .about-mission__aside { position: static; }
    .about-mission__mark { display: none; }
  }

  .about-journey {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) 0;
  }

  .about-journey__header {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .about-journey__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    max-width: 28ch;
  }

  .about-journey__title span {
    display: block;
  }

  .about-journey__line--accent em {
    font-style: italic;
    font-weight: 400;
    color: var(--orange);
  }

  .about-journey__body {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    max-width: 56ch;
    line-height: 1.6;
  }

  .about-journey__milestones {
    display: flex;
    gap: var(--space-l);
    flex-wrap: wrap;
  }

  .milestone {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m) var(--space-l);
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--clay-shadow);
    min-width: 160px;
    flex: 1;
  }

  .milestone__year {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--orange);
  }

  .milestone__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  @media (max-width: 48rem) {
    .about-journey__milestones {
      flex-direction: column;
    }
  }

  @media (max-width: 30rem) {
    .about-hero__title {
      font-size: var(--text-xl);
    }
    .about-mission__body {
      font-size: var(--text-md);
    }
    .about-cta__title {
      font-size: var(--text-xl);
    }
  }
</style>