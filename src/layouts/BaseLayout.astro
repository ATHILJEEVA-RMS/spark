---
/* ============================================================
   BASE LAYOUT — every page's shell.
   Loads design tokens + base + clay utilities, fonts, header,
   footer and the global reveal-on-scroll observer. Carries the
   full SEO/social meta layer and structured data.
   ============================================================ */
import { site } from '../data/site';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import FloatingContact from '../components/ui/FloatingContact.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/clay.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const brandTitle = 'SPARK Drinks';
const pageTitle = title ? `${title} — ${brandTitle}` : brandTitle;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  url: `${site.url}${site.base}/`,
  description: site.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={`${site.url}${site.base}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}${site.base}/og-default.png`} />
    <meta name="theme-color" content="#fdfbf5" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Typography: Fraunces (variable editorial serif) + Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
      media="print"
      id="google-fonts"
    />
    <script is:inline>
      const googleFonts = document.getElementById('google-fonts');
      googleFonts?.addEventListener('load', () => { googleFonts.media = 'all'; });
    </script>
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Space+Grotesk:wght@300..700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/png" href={`${site.base}/spark-favicon.png`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <noscript><nav class="fallback-nav" aria-label="Site pages"><a href="/spark/">Home</a><a href="/spark/flavours">Flavours</a><a href="/spark/about">Our Story</a><a href="/spark/contact">Contact</a></nav></noscript>
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <slot name="atmosphere" />
    <FloatingContact />

    <script>
      /* Global reveal-on-scroll: observes every [data-reveal]
         element once and adds .is-visible. Pure progressive
         enhancement — content is visible without JS via the
         reduced-motion fallback in base.css. */
      const revealElements = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        revealElements.forEach((el) => observer.observe(el));
      } else {
        revealElements.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .fallback-nav { display: flex; flex-wrap: wrap; gap: 1rem; padding: 6rem var(--gutter) 1rem; }
  .fallback-nav a { text-decoration: underline; }
  .skip-link {
    position: fixed;
    top: var(--space-2xs);
    left: 50%;
    translate: -50% -200%;
    z-index: var(--z-overlay);
    padding: 0.7em 1.4em;
    border-radius: var(--radius-pill);
    background: var(--ink-900);
    color: var(--cream-50);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: translate var(--duration-fast) var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    translate: -50% 0;
  }
</style>
